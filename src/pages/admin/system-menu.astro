    // 图标分类列表（用于图标选择器）
    var iconCategories = [
      { name: '导航', icons: ['House', 'HomeFilled', 'Menu', 'Grid', 'Guide', 'Compasses', 'MapLocation', 'Location', 'Aim', 'FullScreen', 'Open', 'Expand'] },
      { name: '内容', icons: ['Document', 'Files', 'Notebook', 'Memo', 'Postcard', 'Reading', 'DocumentAdd', 'DocumentChecked', 'CopyDocument', 'Stamp', 'Paperclip'] },
      { name: '数据', icons: ['DataAnalysis', 'DataBoard', 'DataLine', 'TrendCharts', 'PieChart', 'Histogram', 'Odometer', 'Rank', 'Sort', 'Filter'] },
      { name: '用户', icons: ['User', 'UserFilled', 'Avatar', 'Lock', 'Key', 'Shield', 'SwitchButton', 'TurnOff', 'Medal', 'Trophy'] },
      { name: '通信', icons: ['ChatDotRound', 'ChatSquare', 'ChatLineRound', 'Message', 'MessageBox', 'Notification', 'Bell', 'Edit', 'EditPen', 'Link', 'Share'] },
      { name: '设置', icons: ['Setting', 'Setup', 'Tools', 'Operation', 'Cpu', 'Platform', 'Monitor', 'Service', 'MagicStick', 'Brush', 'Magnet'] },
