---
/**
 * 管理后台 - 说说管理 - /admin/article-moment
 * 说说列表、新增/编辑（弹窗）、批量删除
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/admin.css';
---

<BaseLayout title="说说管理" description="说说管理" currentPath="/admin">
  <div class="content-zone admin-page">
    <!-- 返回链接 -->
    <a href="/admin" class="admin-back-link">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      返回管理后台
    </a>

    <!-- 页面标题 -->
    <div class="page-header">
      <h1>说说管理</h1>
      <p class="page-sub">管理博客说说动态，支持新增、编辑和批量删除</p>
    </div>

    <!-- 工具栏 -->
    <div class="admin-toolbar">
      <button class="glass-btn glass-btn-primary glass-btn-sm" id="btn-add">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        新增说说
      </button>
      <button class="glass-btn glass-btn-ghost glass-btn-sm" id="btn-batch-del">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        批量删除
      </button>
    </div>

    <!-- 表格容器 -->
    <div id="table-container"></div>

    <!-- 分页容器 -->
    <div id="pagination-container"></div>
  </div>
</BaseLayout>

<script is:inline src="/scripts/admin.js"></script>
<script is:inline data-astro-rerun>
  (function () {
    function ready(fn) {
      if (window.Admin) return fn();
      setTimeout(function () { ready(fn); }, 50);
    }
    ready(init);

    function init() {
      var Admin = window.Admin;

    // ===== 登录检查 =====
    if (!Admin.isLoggedIn()) {
      location.href = '/login?redirect=' + encodeURIComponent(location.pathname + location.search);
      return;
    }

    var tableContainer = document.getElementById('table-container');
    var paginationContainer = document.getElementById('pagination-container');
    var selectedIds = [];
    var lastList = [];

    // ===== 保存说说（新增/编辑统一入口） =====
    function saveMoment(data) {
      // 后端要求 images 为逗号分隔的字符串
      if (Array.isArray(data.images)) {
        data.images = data.images.filter(Boolean).join(',');
      } else if (typeof data.images === 'string') {
        data.images = data.images.split(',').map(function (s) { return s.trim(); }).filter(Boolean).join(',');
      }
      if (!data.images) data.images = '';
      if (data.id) {
        return Admin.api.put('/sys/moment/update', data);
      }
      return Admin.api.post('/sys/moment/add', data);
    }

    // ===== 图片列渲染 =====
    function renderImages(images) {
      if (!images) return '<span style="color:var(--text-tertiary);">无</span>';
      var arr = Array.isArray(images) ? images : String(images).split(',').filter(Boolean);
      if (!arr.length) return '<span style="color:var(--text-tertiary);">无</span>';
      var html = arr.slice(0, 3).map(function (url) {
        return '<img class="cell-img" src="' + Admin.esc(url.trim()) + '" onerror="this.style.display=\'none\'" style="margin-right:4px;" />';
      }).join('');
      if (arr.length > 3) {
        html += '<span style="color:var(--text-tertiary);font-size:0.8rem;vertical-align:middle;">+' + (arr.length - 3) + '</span>';
      }
      return html;
    }

    // ===== 内容截断渲染 =====
    function renderContent(content) {
      if (!content) return '<span style="color:var(--text-tertiary);">-</span>';
      var text = Admin.esc(content);
      if (text.length > 50) {
        return '<span title="' + text + '">' + text.substring(0, 50) + '...</span>';
      }
      return text;
    }

    // ===== 打开弹窗 =====
    function openMomentModal(row) {
      var isEdit = !!row;
      var body =
        '<form id="edit-form">' +
          '<div class="admin-form-group">' +
            '<label>内容 <span class="req">*</span></label>' +
            '<textarea class="glass-input" name="content" required placeholder="请输入说说内容" style="min-height:120px;"></textarea>' +
          '</div>' +
          '<div class="admin-form-group">' +
            '<label>图片</label>' +
            '<div id="images-upload"></div>' +
            '<input type="hidden" name="images" />' +
          '</div>' +
        '</form>';
      var footer =
        '<button class="glass-btn glass-btn-ghost glass-btn-sm" data-modal-close>取消</button>' +
        '<button class="glass-btn glass-btn-primary glass-btn-sm" id="btn-save">保存</button>';

      Admin.openModal({
        title: isEdit ? '编辑说说' : '新增说说',
        body: body,
        footer: footer,
        onOpen: function (modal) {
          var form = modal.querySelector('#edit-form');
          // 图片上传组件（多图上传，回显已有图片）
          var initialImages = [];
          if (isEdit && row.images) {
            var imgs = Array.isArray(row.images) ? row.images : String(row.images).split(',').filter(Boolean);
            initialImages = imgs.map(function (s) { return s.trim(); });
          }
          var uploadContainer = modal.querySelector('#images-upload');
          var uploadField = Admin.createUploadField({
            container: uploadContainer,
            value: initialImages,
            multiple: true,
            source: 'moment',
            onChange: function (val) {
              var hiddenInput = form.querySelector('[name="images"]');
              if (hiddenInput) hiddenInput.value = Array.isArray(val) ? val.join(',') : (val || '');
            },
          });
          // 初始化 hidden input
          var hiddenInput = form.querySelector('[name="images"]');
          if (hiddenInput) hiddenInput.value = initialImages.join(',');
          if (isEdit) {
            Admin.fillForm(form, { content: row.content });
          }
          modal.querySelector('#btn-save').addEventListener('click', function () {
            if (!form.checkValidity()) {
              form.reportValidity();
              return;
            }
            var data = Admin.serializeForm(form);
            if (isEdit) data.id = row.id;
            saveMoment(data).then(function () {
              Admin.toast(isEdit ? '修改成功' : '新增成功', 'success');
              Admin.closeModal();
              crud.refresh();
            }).catch(function (err) {
              Admin.toast(err.message || '保存失败', 'error');
            });
          });
        },
      });
    }

    // ===== 列配置 =====
    var columns = [
      { type: 'checkbox' },
      {
        key: 'content', title: '内容',
        render: function (row) { return renderContent(row.content); }
      },
      {
        key: 'images', title: '图片', width: '200px',
        render: function (row) { return renderImages(row.images); }
      },
      {
        key: 'createTime', title: '创建时间', width: '160px',
        render: function (row) { return Admin.formatDate(row.createTime, true); }
      },
      {
        key: 'actions', title: '操作', width: '120px', align: 'center',
        render: function (row) {
          return Admin.actBtn('修改', 'act-edit', null, row.id) +
            Admin.actBtn('删除', 'act-del', null, row.id);
        }
      },
    ];

    // ===== CRUD 列表工厂 =====
    var crud = Admin.createCrudList({
      container: tableContainer,
      paginationEl: paginationContainer,
      columns: columns,
      listApi: function (params) {
        return Admin.api.get('/sys/moment/list', params).then(function (data) {
          lastList = Admin.getPageRecords(data).list;
          return data;
        });
      },
      deleteApi: function (id) { return Admin.api.del('/sys/moment/delete/' + id); },
      deleteLabel: function (row) {
        var c = row.content || '';
        return c.length > 20 ? c.substring(0, 20) + '...' : c;
      },
      emptyText: '暂无说说数据',
      onSelectionChange: function (ids) { selectedIds = ids; },
    });

    // ===== 根据 ID 查找行数据 =====
    function findRowById(id) {
      for (var i = 0; i < lastList.length; i++) {
        if (String(lastList[i].id) === String(id)) return lastList[i];
      }
      return null;
    }

    // ===== 事件绑定 =====
    document.getElementById('btn-add').addEventListener('click', function () {
      openMomentModal(null);
    });
    document.getElementById('btn-batch-del').addEventListener('click', function () {
      crud.batchDelete(selectedIds);
    });

    // 表格操作事件委托（修改/删除）
    tableContainer.addEventListener('click', function (e) {
      var btn = e.target.closest('button[data-id]');
      if (!btn) return;
      var id = btn.getAttribute('data-id');
      if (btn.classList.contains('act-edit')) {
        var row = findRowById(id);
        if (row) openMomentModal(row);
      } else if (btn.classList.contains('act-del')) {
        Admin.confirm('确定要删除该说说吗？', function () {
          Admin.api.del('/sys/moment/delete/' + id).then(function () {
            Admin.toast('删除成功', 'success');
            crud.refresh();
          }).catch(function (err) {
            Admin.toast(err.message || '删除失败', 'error');
          });
        });
      }
    });

    // ===== 初始化 =====
    crud.load();
    }
  })();
</script>
