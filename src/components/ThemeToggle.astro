---
/**
 * ThemeToggle - 深色 / 浅色模式切换
 * - 渲染为 <button class="icon-btn">（圆形按钮，与 TopBar 其他按钮风格一致）
 * - 点击切换 html.dark class
 * - 同步 localStorage('theme')
 * - 太阳/月亮图标根据主题淡入切换
 * - 点击旋转动画
 */
---

<button
  type="button"
  class="icon-btn theme-toggle"
  id="theme-toggle"
  aria-label="切换深色/浅色主题"
  title="切换主题"
>
  <svg class="icon-sun" viewBox="0 0 24 24" stroke="currentColor" fill="none"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2" />
    <path d="M12 20v2" />
    <path d="m4.93 4.93 1.41 1.41" />
    <path d="m17.66 17.66 1.41 1.41" />
    <path d="M2 12h2" />
    <path d="M20 12h2" />
    <path d="m6.34 17.66-1.41 1.41" />
    <path d="m19.07 4.93-1.41 1.41" />
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" stroke="currentColor" fill="none"
       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    overflow: hidden;
  }
  .theme-toggle.spinning {
    transform: rotate(180deg);
  }
  .icon-sun,
  .icon-moon {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    transition: opacity 0.25s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .icon-sun  { opacity: 1; transform: scale(1) rotate(0); }
  .icon-moon { opacity: 0; transform: scale(0.4) rotate(-60deg); }

  :global(.dark) .icon-sun  { opacity: 0; transform: scale(0.4) rotate(60deg); }
  :global(.dark) .icon-moon { opacity: 1; transform: scale(1) rotate(0); }
</style>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', function () {
      const isDark = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', isDark);
      try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}

      btn.classList.add('spinning');
      setTimeout(() => btn.classList.remove('spinning'), 450);
    });
  })();
</script>
