---
/**
 * PinnedCard - 侧栏置顶文章卡片
 * Props:
 *   title, excerpt?, slug
 * 使用 .glass-card 玻璃卡片样式，顶部有置顶徽章。
 */
interface Props {
  title: string;
  excerpt?: string;
  slug: string;
}

const { title, excerpt = '', slug } = Astro.props;
const href = `/article/${slug}`;
---

<article class="pinned-card glass-card" data-reveal>
  <div class="pinned-badge" aria-label="置顶">
    <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 17v5" />
      <path d="M9 10.8V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v5.8l2.5 3.2H6.5L9 10.8z" />
    </svg>
    <span>置顶</span>
  </div>
  <h4 class="pinned-title">
    <a href={href}>{title}</a>
  </h4>
  {excerpt && <p class="pinned-excerpt">{excerpt}</p>}
  <a href={href} class="read-more">
    阅读全文
    <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14" />
      <path d="m13 6 6 6-6 6" />
    </svg>
  </a>
</article>

<style>
  .pinned-card {
    position: relative;
    padding: var(--sp-5);
    background: linear-gradient(135deg,
      rgba(102,126,234,0.10),
      rgba(240,147,251,0.10)
    ), var(--glass-bg);
    overflow: hidden;
  }

  .pinned-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--sp-3);
    padding: 3px 10px;
    border-radius: var(--r-full);
    background: rgba(102,126,234,0.12);
    border: 1px solid rgba(102,126,234,0.22);
  }
  .pinned-badge svg { width: 13px; height: 13px; }

  .pinned-title {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.45;
    margin: 0 0 var(--sp-2) 0;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .pinned-title a {
    color: inherit !important;
    background: linear-gradient(90deg, var(--text-primary), var(--text-primary));
    transition: color var(--dur-fast) var(--ease-out);
  }
  .pinned-title a:hover {
    color: var(--brand) !important;
  }

  .pinned-excerpt {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 var(--sp-4) 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--brand) !important;
    transition: gap var(--dur-fast) var(--ease-out);
  }
  .read-more svg { width: 14px; height: 14px; transition: transform var(--dur-fast) var(--ease-out); }
  .read-more:hover { gap: 8px; }
  .read-more:hover svg { transform: translateX(2px); }
</style>
