    function initLikeButton(articleId, serverIsLike) {
      var btn = document.getElementById('article-like-btn');
      if (!btn) return;
      likeArticleId = articleId;
      // 初始状态：优先用后端返回的 isLike；未提供时回落本地缓存
      var isLiked;
      if (typeof serverIsLike === 'boolean') {
        isLiked = serverIsLike;
      } else {
        var likedArticles = [];
        try { likedArticles = JSON.parse(localStorage.getItem('liked_articles') || '[]'); } catch(e) {}
        isLiked = likedArticles.indexOf(String(articleId)) >= 0;
      }
      updateLikeButton(btn, isLiked);

      // 未登录：禁用按钮，点击时提示并引导登录
      if (!window.__api || !window.__api.isLoggedIn()) {
        btn.disabled = true;
        btn.title = '请先登录后再点赞';
