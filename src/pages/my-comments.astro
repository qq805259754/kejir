---
/**
 * 我的评论 - /my-comments
 * 玻璃风格列表 + 搜索 + 无限滚动分页 + 删除
 * BaseLayout 已包含 Sidebar、TopBar、RightPanel、AppFooter
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="我的评论" description="我的评论">
  <!-- 页面头部 -->
  <div class="page-hero">
    <a href="/profile" id="back-link" class="back-link back-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>返回个人中心</span>
    </a>
    <h1>我的评论</h1>
    <p id="hint">登录后可查看你的评论记录</p>
  </div>

  <!-- 未登录引导 -->
  <div id="guest-view" class="glass-card guest-card" data-reveal>
    <div class="guest-icon">?</div>
    <h2>请先登录</h2>
    <p>登录后可查看和管理你发表的评论</p>
    <div class="guest-actions">
      <a href="/login?redirect=/my-comments" class="glass-btn glass-btn-primary">立即登录</a>
      <a href="/" class="glass-btn glass-btn-ghost">返回首页</a>
    </div>
  </div>

  <!-- 已登录视图 -->
  <div id="logged-view" style="display:none;">
    <!-- 搜索栏 -->
    <div class="search-bar" data-reveal>
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input class="search-input" id="search-input" type="text" placeholder="搜索评论相关文章" autocomplete="off" />
      <button type="button" class="glass-btn glass-btn-ghost glass-btn-sm" id="clear-search" style="display:none;">清除</button>
    </div>

    <!-- 列表信息 -->
    <div class="list-info" id="list-info"></div>

    <!-- 评论列表 -->
    <div id="comments-list" class="comment-list"></div>

    <!-- 加载中 -->
    <div id="loading" class="loading-wrap" style="display:none;">
      <div class="spinner"></div>
      <span>加载中...</span>
    </div>

    <!-- 没有更多 -->
    <div id="no-more" class="no-more" style="display:none;">没有更多了</div>

    <!-- 空状态 -->
    <div id="empty-state" class="glass-card empty-card" style="display:none;" data-reveal>
      <h3 id="empty-title">暂无评论</h3>
      <p id="empty-desc">你还没有发表任何评论</p>
    </div>

    <!-- 错误状态 -->
    <div id="error-state" class="glass-card error-card" style="display:none;" data-reveal>
      <h3>加载失败</h3>
      <p>网络异常，请稍后重试</p>
      <button type="button" class="glass-btn glass-btn-primary" id="retry-btn">重新加载</button>
    </div>

    <!-- 无限滚动哨兵 -->
    <div id="sentinel" aria-hidden="true"></div>
  </div>
</BaseLayout>

<style is:global>
  /* 返回链接 */
  .back-link {
    margin-bottom: var(--sp-4);
    display: inline-flex;
  }
  .back-link svg { width: 14px; height: 14px; }

  /* 未登录卡片 */
  .guest-card {
    text-align: center;
    padding: var(--sp-10);
  }
  .guest-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--accent-gradient);
    margin: 0 auto var(--sp-5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 2rem;
    font-weight: 800;
  }
  .guest-card h2 {
    margin-bottom: var(--sp-2);
  }
  .guest-card p {
    color: var(--text-tertiary);
    margin-bottom: var(--sp-6);
  }
  .guest-actions {
    display: flex;
    gap: var(--sp-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* 搜索栏（玻璃容器，无 hover 抬升） */
  .search-bar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    margin-bottom: var(--sp-4);
    border-radius: var(--r-lg);
    background: var(--lg-bg);
    border: var(--lg-border-width) solid var(--lg-border);
    backdrop-filter: blur(var(--lg-blur));
    -webkit-backdrop-filter: blur(var(--lg-blur));
    box-shadow: var(--lg-shadow);
  }
  .flat .search-bar {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: var(--surface);
    border-color: var(--border);
  }
  .search-bar .search-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--text-tertiary);
  }

  /* 搜索输入框 — 与 profile.astro 的 .form-input 保持一致 */
  .search-input {
    flex: 1;
    min-width: 0;
    padding: 11px 14px;
    border-radius: 10px;
    border: 1px solid var(--lg-border);
    background: var(--lg-bg);
    backdrop-filter: blur(var(--lg-blur));
    -webkit-backdrop-filter: blur(var(--lg-blur));
    font-size: 0.88rem;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }
  .flat .search-input {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: var(--bg-secondary);
    border-color: var(--border);
  }
  .search-input:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-a15);
  }
  .search-input::placeholder {
    color: var(--text-tertiary);
  }

  /* 列表信息 */
  .list-info {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    margin-bottom: var(--sp-3);
    min-height: 1em;
  }

  /* 评论列表 */
  .comment-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  /* 评论卡片：轻量玻璃风格，内容区 + 操作区 flex 布局 */
  .comment-card {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--r-md);
    background: var(--lg-bg);
    border: 1px solid var(--lg-border);
    backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate));
    -webkit-backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate));
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    animation: cardFadeIn 0.4s ease both;
  }
  .flat .comment-card {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: var(--surface);
    border-color: var(--border);
    box-shadow: none;
  }
  @keyframes cardFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .comment-card:hover {
    border-color: var(--brand-a30);
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    transform: translateY(-1px);
  }
  .flat .comment-card:hover {
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  }
  .comment-card.deleting {
    opacity: 0.45;
    pointer-events: none;
  }
  .comment-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .comment-card-content {
    font-size: 0.95rem;
    color: var(--text-primary);
    line-height: 1.6;
    word-break: break-word;
    margin: 0;
  }
  .comment-card-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    font-size: 0.75rem;
    color: var(--text-tertiary);
    margin-top: var(--sp-1);
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .meta-item svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }
  .meta-article {
    color: var(--brand);
    text-decoration: none;
    transition: color 0.2s, opacity 0.2s;
  }
  .meta-article:hover {
    opacity: 0.8;
  }
  .meta-article-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 360px;
  }
  .comment-card-actions {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    flex-shrink: 0;
  }
  .comment-card-actions .action-btn {
    white-space: nowrap;
  }

  /* 加载中 */
  .loading-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    padding: var(--sp-6);
    color: var(--text-tertiary);
    font-size: 0.85rem;
  }
  .spinner {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2.5px solid var(--brand-a20);
    border-top-color: var(--brand);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* 没有更多 */
  .no-more {
    text-align: center;
    padding: var(--sp-6);
    color: var(--text-tertiary);
    font-size: 0.82rem;
  }

  /* 空状态 */
  .empty-card {
    text-align: center;
    padding: var(--sp-10);
  }
  .empty-card h3 {
    margin-bottom: var(--sp-2);
  }
  .empty-card p {
    color: var(--text-tertiary);
  }

  /* 错误状态 */
  .error-card {
    text-align: center;
    padding: var(--sp-8);
  }
  .error-card h3 {
    margin-bottom: var(--sp-2);
  }
  .error-card p {
    color: var(--text-tertiary);
    margin-bottom: var(--sp-4);
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .comment-card {
      flex-direction: column;
      gap: var(--sp-3);
      padding: var(--sp-4);
    }
    .comment-card-actions {
      flex-direction: row;
      width: 100%;
    }
    .comment-card-actions .action-btn {
      flex: 1;
      justify-content: center;
    }
    .meta-article-text {
      max-width: 220px;
    }
    .search-bar {
      flex-wrap: wrap;
      padding: var(--sp-3);
    }
    .search-input {
      width: 100%;
      flex-basis: 100%;
    }
    #clear-search {
      margin-left: auto;
    }
    .guest-card,
    .empty-card,
    .error-card {
      padding: var(--sp-6);
    }
  }
</style>

<script is:inline data-astro-rerun>
  // 返回链接：支持 ?from=me 返回到"我的"页面
  (function () {
    var params = new URLSearchParams(window.location.search);
    var from = params.get('from');
    var backLink = document.getElementById('back-link');
    if (backLink && from === 'me') {
      backLink.href = '/about';
      var label = backLink.querySelector('span:last-child') || backLink.lastChild;
      if (label && label.textContent) label.textContent = '返回我的';
    }
  })();

  (function () {
    var guestView = document.getElementById('guest-view');
    var loggedView = document.getElementById('logged-view');
    var searchInput = document.getElementById('search-input');
    var clearBtn = document.getElementById('clear-search');
    var listEl = document.getElementById('comments-list');
    var listInfo = document.getElementById('list-info');
    var loadingEl = document.getElementById('loading');
    var noMoreEl = document.getElementById('no-more');
    var emptyEl = document.getElementById('empty-state');
    var emptyTitle = document.getElementById('empty-title');
    var emptyDesc = document.getElementById('empty-desc');
    var errorEl = document.getElementById('error-state');
    var retryBtn = document.getElementById('retry-btn');
    var sentinel = document.getElementById('sentinel');

    var PAGE_SIZE = window.__DEFAULT_PAGE_SIZE__ || 10;
    var pageNum = 1;
    var total = 0;
    var hasMore = true;
    var isLoading = false;
    var currentKeyword = '';
    var searchTimer = null;
    var firstLoaded = false;
    var errorShown = false;

    // ---- 图标 ----
    var ICON_ARTICLE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>';
    var ICON_DATE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>';
    var ICON_DEL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>';

    function isLoggedIn() {
      if (window.__api && typeof window.__api.isLoggedIn === 'function') {
        return window.__api.isLoggedIn();
      }
      try { return !!localStorage.getItem('token'); } catch (e) { return false; }
    }

    function showGuest() {
      if (guestView) guestView.style.display = '';
      if (loggedView) loggedView.style.display = 'none';
    }
    function showLogged() {
      if (guestView) guestView.style.display = 'none';
      if (loggedView) loggedView.style.display = '';
    }

    // 兼容多种响应结构：{rows,total} / {data:{rows,total}} / {list,total} / {records,total}
    function normalize(res) {
      if (!res) return { rows: [], total: 0 };
      var data = res;
      if (data.data && (data.data.rows || data.data.list || data.data.records || Array.isArray(data.data))) {
        data = data.data;
      }
      var rows = data.rows || data.list || data.records || (Array.isArray(data) ? data : []);
      if (!Array.isArray(rows)) rows = [];
      var t = (data.total !== undefined) ? data.total
            : (data.totalCount !== undefined ? data.totalCount
            : (data.count !== undefined ? data.count : rows.length));
      return { rows: rows, total: t };
    }

    function escapeHtml(s) {
      if (s === null || s === undefined) return '';
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function pad(n) { n = parseInt(n, 10); return n < 10 ? '0' + n : '' + n; }

    function formatDate(d) {
      if (!d && d !== 0) return '';
      if (typeof d === 'number') {
        var dt = new Date(d < 1e12 ? d * 1000 : d);
        if (!isNaN(dt.getTime())) {
          return dt.getFullYear() + '-' + pad(dt.getMonth() + 1) + '-' + pad(dt.getDate()) + ' ' + pad(dt.getHours()) + ':' + pad(dt.getMinutes());
        }
      }
      var s = String(d);
      // 匹配带时间的格式 2024-01-02 12:30
      var mt = s.match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})[ T](\d{1,2}):(\d{1,2})/);
      if (mt) return mt[1] + '-' + pad(mt[2]) + '-' + pad(mt[3]) + ' ' + pad(mt[4]) + ':' + pad(mt[5]);
      var m = s.match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
      if (m) return m[1] + '-' + pad(m[2]) + '-' + pad(m[3]);
      return s;
    }

    function pickField(item, keys) {
      for (var i = 0; i < keys.length; i++) {
        var v = item[keys[i]];
        if (v !== undefined && v !== null && v !== '') return v;
      }
      return '';
    }

    function renderComment(item) {
      var id = item.id;
      var content = pickField(item, ['content', 'commentContent', 'text', 'message']) || '（无内容）';
      var articleTitle = pickField(item, ['articleTitle', 'title', 'articleName', 'postTitle']);
      var articleId = pickField(item, ['articleId', 'postId', 'aid', 'articleUuid']);
      var date = pickField(item, ['createTime', 'date', 'createdAt', 'createdTime', 'updateTime']);

      // 文章标题（如有 articleId 则为链接）
      var articleHtml = '';
      if (articleTitle) {
        if (articleId) {
          articleHtml = '<a href="/article/' + encodeURIComponent(articleId) + '" class="meta-item meta-article" title="' + escapeHtml(articleTitle) + '">' + ICON_ARTICLE + '<span class="meta-article-text">' + escapeHtml(articleTitle) + '</span></a>';
        } else {
          articleHtml = '<span class="meta-item meta-article" title="' + escapeHtml(articleTitle) + '">' + ICON_ARTICLE + '<span class="meta-article-text">' + escapeHtml(articleTitle) + '</span></span>';
        }
      }

      var html = '<div class="comment-card" data-id="' + escapeHtml(id) + '">' +
        '<div class="comment-card-body">' +
          '<p class="comment-card-content">' + escapeHtml(content) + '</p>' +
          '<div class="comment-card-meta">' +
            articleHtml +
            (date ? '<span class="meta-item">' + ICON_DATE + escapeHtml(formatDate(date)) + '</span>' : '') +
          '</div>' +
        '</div>' +
        '<div class="comment-card-actions">' +
          '<button type="button" class="action-btn action-btn-delete delete-btn" data-id="' + escapeHtml(id) + '">' + ICON_DEL + '删除</button>' +
        '</div>' +
      '</div>';
      return html;
    }

    function setLoading(v) {
      isLoading = v;
      if (loadingEl) loadingEl.style.display = v ? 'flex' : 'none';
    }

    function updateListInfo() {
      if (!listInfo) return;
      var count = listEl ? listEl.querySelectorAll('.comment-card').length : 0;
      if (firstLoaded && total > 0) {
        listInfo.textContent = '共 ' + total + ' 条评论' + (currentKeyword ? ' · 关键词“' + currentKeyword + '”' : '');
      } else if (firstLoaded && count === 0) {
        listInfo.textContent = currentKeyword ? '未找到与“' + currentKeyword + '”相关的评论' : '';
      } else {
        listInfo.textContent = '';
      }
    }

    function updateEmptyState() {
      var count = listEl ? listEl.querySelectorAll('.comment-card').length : 0;
      if (emptyEl) emptyEl.style.display = (count === 0 && !isLoading && !errorShown) ? '' : 'none';
      if (emptyTitle && emptyDesc) {
        if (currentKeyword) {
          emptyTitle.textContent = '未找到相关评论';
          emptyDesc.textContent = '换个关键词试试吧';
        } else {
          emptyTitle.textContent = '暂无评论';
          emptyDesc.textContent = '你还没有发表任何评论';
        }
      }
      if (noMoreEl) noMoreEl.style.display = (hasMore === false && count > 0 && !isLoading) ? '' : 'none';
      updateListInfo();
    }

    function load(page) {
      if (isLoading) return;
      if (!hasMore && page !== 1) return;
      if (!window.__api || typeof window.__api.myComment !== 'function') return;
      setLoading(true);
      errorShown = false;
      if (errorEl) errorEl.style.display = 'none';

      window.__api.myComment(page, PAGE_SIZE, currentKeyword).then(function (res) {
        var result = normalize(res);
        if (page === 1) {
          if (listEl) listEl.innerHTML = '';
          total = result.total;
        }
        var rows = result.rows;
        if (listEl) {
          for (var i = 0; i < rows.length; i++) {
            listEl.insertAdjacentHTML('beforeend', renderComment(rows[i]));
          }
        }
        pageNum = page;
        firstLoaded = true;
        var loadedCount = listEl ? listEl.querySelectorAll('.comment-card').length : 0;
        if (rows.length < PAGE_SIZE || loadedCount >= total) {
          hasMore = false;
        } else {
          hasMore = true;
        }
        setLoading(false);
        updateEmptyState();
      }).catch(function () {
        if (page === 1 && listEl) listEl.innerHTML = '';
        firstLoaded = true;
        hasMore = false;
        errorShown = true;
        setLoading(false);
        if (errorEl) errorEl.style.display = '';
        if (emptyEl) emptyEl.style.display = 'none';
        if (noMoreEl) noMoreEl.style.display = 'none';
        updateListInfo();
      });
    }

    function resetAndLoad() {
      pageNum = 1;
      hasMore = true;
      total = 0;
      errorShown = false;
      if (listEl) listEl.innerHTML = '';
      if (noMoreEl) noMoreEl.style.display = 'none';
      if (emptyEl) emptyEl.style.display = 'none';
      if (errorEl) errorEl.style.display = 'none';
      load(1);
    }

    function handleDelete(id, card) {
      if (!id) return;
      window.__showConfirm('确定要删除这条评论吗？删除后不可恢复。', function () {
      var delBtn = card ? card.querySelector('.delete-btn') : null;
      if (card) card.classList.add('deleting');
      if (delBtn) {
        delBtn.disabled = true;
        delBtn.setAttribute('data-original', delBtn.innerHTML);
        delBtn.innerHTML = '删除中...';
      }

      window.__api.delComment(id).then(function (res) {
        // 兼容业务码失败（HTTP 200 但 code 非 200）
        if (res && res.code !== undefined && res.code !== 200 && res.code !== 0) {
          throw new Error(res.message || '删除失败');
        }
        if (card && card.parentNode) card.parentNode.removeChild(card);
        total = Math.max(0, total - 1);
        updateEmptyState();
      }).catch(function (err) {
        if (card) card.classList.remove('deleting');
        if (delBtn) {
          delBtn.disabled = false;
          var orig = delBtn.getAttribute('data-original');
          if (orig) delBtn.innerHTML = orig;
        }
        window.__showToast(err && err.message ? err.message : '删除失败，请稍后重试', 'error');
      });
      });
    }

    // 列表事件委托（删除按钮）
    if (listEl) {
      listEl.addEventListener('click', function (e) {
        var delBtn = e.target.closest ? e.target.closest('.delete-btn') : null;
        if (delBtn) {
          e.preventDefault();
          var id = delBtn.getAttribute('data-id');
          var card = delBtn.closest ? delBtn.closest('.comment-card') : null;
          handleDelete(id, card);
        }
      });
    }

    // 搜索（输入防抖 + 回车立即）
    if (searchInput) {
      searchInput.addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function () {
          currentKeyword = searchInput.value.trim();
          if (clearBtn) clearBtn.style.display = currentKeyword ? '' : 'none';
          resetAndLoad();
        }, 350);
      });
      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.keyCode === 13) {
          e.preventDefault();
          clearTimeout(searchTimer);
          currentKeyword = searchInput.value.trim();
          if (clearBtn) clearBtn.style.display = currentKeyword ? '' : 'none';
          resetAndLoad();
        }
      });
    }

    // 清除搜索
    if (clearBtn) {
      clearBtn.addEventListener('click', function () {
        if (searchInput) searchInput.value = '';
        currentKeyword = '';
        clearBtn.style.display = 'none';
        resetAndLoad();
        if (searchInput) searchInput.focus();
      });
    }

    // 重试
    if (retryBtn) {
      retryBtn.addEventListener('click', function () {
        resetAndLoad();
      });
    }

    // 无限滚动
    function setupInfiniteScroll() {
      if (!sentinel) return;
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting && !isLoading && hasMore) {
              load(pageNum + 1);
            }
          }
        }, { rootMargin: '200px' });
        io.observe(sentinel);
      } else {
        window.addEventListener('scroll', function () {
          if (isLoading || !hasMore) return;
          var rect = sentinel.getBoundingClientRect();
          if (rect.top < window.innerHeight + 200) load(pageNum + 1);
        }, { passive: true });
      }
    }

    // 初始化
    if (isLoggedIn()) {
      showLogged();
      setupInfiniteScroll();
      load(1);
    } else {
      showGuest();
    }

    // 登录态变化时刷新视图
    window.addEventListener('storage', function () {
      if (isLoggedIn()) {
        showLogged();
        if (!firstLoaded) load(1);
      } else {
        showGuest();
      }
    });
  })();
</script>
