    <!-- GSAP 按需加载：仅在非移动端（>=768px）注入，移动端首页轮播走轻量 CSS/JS 分支，
         避免为移动端加载约 70KB 的动画库，加快首屏与页面切换 -->
    <script is:inline define:vars={{ gsapUrl }}>
      (function () {
        try {
          if (window.innerWidth >= 768 && !window.gsap) {
            var s = document.createElement('script');
            s.src = gsapUrl;
            s.defer = true;
            s.async = true;
            s.onload = function () { window.dispatchEvent(new Event('gsap:loaded')); };
            document.body.appendChild(s);
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline>
      // 移动端性能优化：禁用重度视觉效果，降低 GPU 持续开销
      (function () {
        var isMobile = window.matchMedia('(max-width: 768px)').matches || (window.innerWidth < 768);
        if (!isMobile) return;
        // 移除 SVG 涟漪 filter 中的无限 <animate> 循环（feTurbulence seed 每帧重算）
        try {
          var anims = document.querySelectorAll('#liquid-glass-ripple animate, [id*="liquid-glass"] animate');
          for (var i = 0; i < anims.length; i++) anims[i].remove();
        } catch (e) {}
        // 触屏设备无鼠标，移除涟漪动画与鼠标高亮追踪，减少事件与 DOM 开销
        if (window.matchMedia('(hover: none), (pointer: coarse)').matches) {
          var ripple = document.querySelector('.glass-ripple');
          var style = document.createElement('style');
          style.textContent = '.glass-ripple{display:none!important;}';
          document.head.appendChild(style);
        }
      })();
    </script>
    <script is:inline>
      // Global mouse-tracking specular highlight + water ripple trail for glass surfaces
      (function() {
        var root = document.documentElement;
        var rafId = null;
        var mx = 50, my = 50;
        var trailCount = 0;
        var lastTrailTime = 0;
        var isFlat = false;

        function update() {
          root.style.setProperty('--mouse-x', mx + '%');
          root.style.setProperty('--mouse-y', my + '%');
          rafId = null;
        }

        // Create a water ripple droplet at the cursor position
        function spawnRipple(x, y) {
          if (isFlat) return;
          var ripple = document.createElement('div');
          ripple.className = 'glass-ripple';
          ripple.style.left = x + 'px';
          ripple.style.top = y + 'px';
          document.body.appendChild(ripple);
          // Auto-remove after animation completes
          setTimeout(function() {
            if (ripple.parentNode) ripple.parentNode.removeChild(ripple);
          }, 900);
        }

        document.addEventListener('mousemove', function(e) {
          mx = (e.clientX / window.innerWidth) * 100;
          my = (e.clientY / window.innerHeight) * 100;
          if (!rafId) rafId = requestAnimationFrame(update);

          // Spawn ripple droplets when moving over glass surfaces
          // Detects: explicit data-glass, classnames, or elements with backdrop-filter
          var now = Date.now();
          if (now - lastTrailTime < 70) return;
          var target = e.target;
          var onGlass = false;
          var glassClasses = {
            'glass-surface':1,'glass-card':1,'glass-panel':1,'glass-btn':1,
            'stack-card':1,'sidebar':1,'topbar':1,'topbar-search':1,
            'right-panel':1,'app-footer':1,'me-group':1,'link-card':1,
            'mini-post-card':1,'h-post-card':1,'topbar-icon-btn':1,
            'topbar-avatar':1
          };
          while (target && target !== document.body) {
            if (target.nodeType === 1) {
              if (target.dataset && target.dataset.glass !== undefined) { onGlass = true; break; }
              var cls = target.classList;
              if (cls) {
                for (var c in glassClasses) { if (cls.contains(c)) { onGlass = true; break; } }
                if (onGlass) break;
              }
            }
            target = target.parentNode;
          }
          if (onGlass) {
            lastTrailTime = now;
            spawnRipple(e.clientX, e.clientY);
            trailCount++;
          }
        }, { passive: true });

        // Watch for flat mode toggle to disable ripples
        var flatObserver = new MutationObserver(function() {
          isFlat = root.classList.contains('flat');
        });
        flatObserver.observe(root, { attributes: true, attributeFilter: ['class'] });
        isFlat = root.classList.contains('flat');
      })();
    </script>

