        initLikeButton(article.id || id, article.isLike);
      }

      // 正文：优先使用 content（HTML），其次 contentMd（Markdown）
      var body = article.content || article.body || article.contentMd || article.excerpt || '';
      if (contentEl && body) {
        contentEl.innerHTML = renderContent(body);
      }

      if (tagsEl) {
        var tags = [];
        if (Array.isArray(article.tags)) tags = article.tags;
        else if (article.tagList) tags = String(article.tagList).split(',').map(function(s){return s.trim();}).filter(Boolean);
        if (tags.length) {
          tagsEl.innerHTML = tags.map(function(t){
            return '<a href="/tags/' + encodeURIComponent(t) + '" class="tag">' + escHtml(t) + '</a>';
          }).join('');
