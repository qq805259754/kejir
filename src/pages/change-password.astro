---
/**
 * 修改密码 - /change-password
 * BaseLayout 已包含 Sidebar、TopBar、RightPanel、AppFooter
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="修改密码" description="修改密码">
  <div class="page-hero">
    <a href="/profile" id="back-link" class="back-btn" style="margin-bottom:var(--sp-4);">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>返回个人中心</span>
    </a>
    <h1>修改密码</h1>
    <p>定期修改密码以保护账户安全</p>
  </div>

  <div class="glass-card" data-reveal style="max-width:480px;">
    <form id="pwd-form">
      <div class="form-group">
        <label>当前密码</label>
        <input type="password" name="oldPwd" placeholder="请输入当前密码" />
      </div>
      <div class="form-group">
        <label>新密码</label>
        <input type="password" name="newPwd" placeholder="6-20位新密码" />
      </div>
      <div class="form-group">
        <label>确认新密码</label>
        <input type="password" name="confirmPwd" placeholder="再次输入新密码" />
      </div>
      <button type="submit" class="glass-btn glass-btn-primary" style="width:100%;justify-content:center;">确认修改</button>
    </form>
  </div>
</BaseLayout>

<script is:inline data-astro-rerun>
  // 返回链接：支持 ?from=me 返回到"我的"页面
  (function () {
    var params = new URLSearchParams(window.location.search);
    var from = params.get('from');
    var backLink = document.getElementById('back-link');
    if (backLink && from === 'me') {
      backLink.href = '/about';
      var label = backLink.querySelector('span:last-child') || backLink.lastChild;
      if (label && label.textContent) label.textContent = '返回我的';
    }
  })();

  (function () {
    var form = document.getElementById('pwd-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var token = localStorage.getItem('token');
      if (!token) { window.location.href = '/login'; return; }
      window.__showToast('修改密码功能开发中', 'info');
    });
  })();
</script>
