---
/**
 * BaseLayout - 全局布局容器
 * 三列 grid: sidebar | topbar/topbar | main/side | footer/footer
 * 移动端切换为单列 + 底部 MobileNav
 * - showRightPanel=true（仅首页）显示右侧标签+文章+关于面板
 */
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import RightPanel from '../components/RightPanel.astro';
import AppFooter from '../components/AppFooter.astro';
import MobileNav from '../components/MobileNav.astro';
import MobilePanels from '../components/MobilePanels.astro';
import { siteConfig } from '../data/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  showRightPanel?: boolean;
}

const {
  title,
  description = siteConfig.description,
  currentPath = Astro.url.pathname,
  showRightPanel = false,
} = Astro.props as Props;

const pageTitle = title ? `${title} - ${siteConfig.title}` : siteConfig.title;
const apiBase = import.meta.env.PUBLIC_API_BASE || '';
const logoUrl = import.meta.env.PUBLIC_SITE_LOGO || '';
const isDev = import.meta.env.DEV;
const defaultPageSize = parseInt(import.meta.env.PUBLIC_DEFAULT_PAGE_SIZE || '10', 10);
const harmonyOSRegularUrl = import.meta.env.PUBLIC_HARMONYOS_REGULAR_URL || 'https://unpkg.com/harmonyos-sans-sc-webfont-splitted/Regular.css';
const harmonyOSBoldUrl = import.meta.env.PUBLIC_HARMONYOS_BOLD_URL || 'https://unpkg.com/harmonyos-sans-sc-webfont-splitted/Bold.css';
const gsapUrl = import.meta.env.PUBLIC_GSAP_URL || 'https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js';
const diceBearBase = import.meta.env.PUBLIC_DICE_BEAR_BASE || 'https://api.dicebear.com/7.x/avataaars/svg?seed=';
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="description" content={description} />
    <meta name="keywords" content={siteConfig.keywords.join(',')} />
    <!-- 解决 strict-origin-when-cross-origin：允许跨域请求携带完整 Referrer -->
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <link rel="icon" type="image/png" href={logoUrl || '/favicon.svg'} id="favicon-link" />
    <title>{pageTitle}</title>
    <ClientRouter />
    <!-- HarmonyOS Sans SC Web Font (Regular + Bold) -->
    <link rel="stylesheet" href={harmonyOSRegularUrl} />
    <link rel="stylesheet" href={harmonyOSBoldUrl} />
    <script is:inline define:vars={{ apiBase, logoUrl, isDev, defaultPageSize, diceBearBase }}>
      (function(){
        // 开发环境：通过 Astro 服务器端代理（/api/[...path].ts）转发到后端，同源无跨域
        // 生产环境：同样通过 Astro 服务器端代理转发，或直接使用后端地址
        // 后端地址在 .env.local / .env.production 中通过 PUBLIC_API_BASE 配置
        window.__API_BASE__ = '';
        window.__DEFAULT_LOGO__ = logoUrl || '';
        window.__DEFAULT_PAGE_SIZE__ = defaultPageSize;
        window.__DICE_BEAR_BASE__ = diceBearBase;
        // 本地确定性头像生成器（替代国外 dicebear 服务，国内访问零延迟、不报错）
        // 基于 seed 哈希生成稳定配色 + 几何图案，输出 data:URL SVG，完全离线可用。
        // 兼容原 __DICE_BEAR_BASE__ 用法：window.__DICE_BEAR_BASE__ + seed 也能得到本地头像。
        function __hashSeed(s) {
          var h = 2166136261;
          var str = String(s == null ? 'guest' : s);
          for (var i = 0; i < str.length; i++) {
            h ^= str.charCodeAt(i);
            h = (h * 16777619) >>> 0;
          }
          return h;
        }
        function __localAvatar(seed) {
          try {
            var h = __hashSeed(seed);
            var palette = [
              '#5B8DEF', '#7C6FF0', '#E8637A', '#2FB5A5', '#F5A623',
              '#3A7BD5', '#9B59B6', '#E74C3C', '#16A085', '#F39C12'
            ];
            var bg = palette[h % palette.length];
            var bg2 = palette[(h >> 4) % palette.length];
            var hue = (h % 36) * 10;
            var shape = (h >> 8) % 4;
            var cx = 20 + (h % 8), cy = 16 + ((h >> 6) % 10);
            var shapes = [
              '<circle cx="' + cx + '" cy="' + cy + '" r="9" fill="rgba(255,255,255,0.32)"/>',
              '<rect x="' + (cx-6) + '" y="' + (cy-6) + '" width="12" height="12" rx="3" fill="rgba(255,255,255,0.30)"/>',
              '<path d="M' + cx + ' ' + (cy-8) + 'l8 14h-16z" fill="rgba(255,255,255,0.30)"/>',
              '<circle cx="' + cx + '" cy="' + cy + '" r="9" fill="rgba(255,255,255,0.28)"/><circle cx="' + (cx+5) + '" cy="' + (cy-4) + '" r="2.5" fill="rgba(255,255,255,0.45)"/>'
            ];
            var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">'
              + '<defs><linearGradient id="g' + h + '" x1="0" y1="0" x2="1" y2="1">'
              + '<stop offset="0" stop-color="' + bg + '"/><stop offset="1" stop-color="' + bg2 + '"/></linearGradient></defs>'
              + '<rect width="64" height="64" rx="12" fill="url(#g' + h + ')"/>'
              + shapes[shape] + '</svg>';
            return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
          } catch (e) {
            return '';
          }
        }
        // 让现有 __DICE_BEAR_BASE__ + seed 用法直接得到本地头像
        if (!window.__DICE_BEAR_BASE__ || /dicebear\.com/i.test(window.__DICE_BEAR_BASE__)) {
          window.__DICE_BEAR_BASE__ = 'local:';
        }
        window.__genAvatar = __localAvatar;
        // 全局轻量 Toast 提示（替代原生 alert，统一液态玻璃风格）
        var __toastTimer = null;
        window.__showToast = function(msg, type) {
          var old = document.getElementById('global-toast');
          if (old) old.remove();
          if (__toastTimer) { clearTimeout(__toastTimer); __toastTimer = null; }
          var t = document.createElement('div');
          t.id = 'global-toast';
          t.style.cssText = 'position:fixed;top:24px;left:50%;transform:translateX(-50%);z-index:99999;padding:12px 24px;border-radius:12px;font-size:0.9rem;font-weight:500;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);transition:all 0.3s ease;opacity:0;pointer-events:none;max-width:90vw;text-align:center;';
          if (type === 'error') {
            t.style.background = 'rgba(239,68,68,0.12)';
            t.style.color = '#ef4444';
            t.style.border = '1px solid rgba(239,68,68,0.2)';
          } else if (type === 'success') {
            t.style.background = 'rgba(34,197,94,0.12)';
            t.style.color = '#22c55e';
            t.style.border = '1px solid rgba(34,197,94,0.2)';
          } else {
            t.style.background = 'rgba(255,255,255,0.12)';
            t.style.color = 'var(--text-primary, #333)';
            t.style.border = '1px solid var(--glass-border, rgba(255,255,255,0.2))';
          }
          t.textContent = msg;
          document.body.appendChild(t);
          requestAnimationFrame(function() { t.style.opacity = '1'; });
          __toastTimer = setTimeout(function() {
            t.style.opacity = '0';
            setTimeout(function() { if (t.parentNode) t.remove(); }, 300);
          }, 2600);
        };
        function api(path, options) {
          var base = window.__API_BASE__ || '';
          var opts = options || {};
          // Inject Authorization token for authenticated requests
          var token = '';
          try { token = localStorage.getItem('token') || ''; } catch(e) {}
          var headers = opts.headers || {};
          if (token) headers['Authorization'] = token;
          // 仅对非 FormData 的 body 设置 JSON Content-Type；FormData 由浏览器自动设置 multipart boundary，不可手动指定
          if (opts.body && !(opts.body instanceof FormData) && !headers['Content-Type']) headers['Content-Type'] = 'application/json';
          opts.headers = headers;
          // 解决 strict-origin-when-cross-origin：显式设置 referrerPolicy + credentials
          opts.referrerPolicy = 'no-referrer-when-downgrade';
          opts.credentials = 'include';
          opts.mode = 'cors';
          return fetch(base + path, opts).then(function(r){
            if (!r.ok) throw new Error('API ' + path + ' failed: ' + r.status);
            // 先读文本再解析，避免空 body 导致 r.json() 崩溃
            return r.text().then(function(text) {
              if (!text || text.trim() === '') return {};
              try { return JSON.parse(text); } catch(e) { return {}; }
            }).then(function(d) {
              // 401 未登录或登录已过期：清除登录状态并跳转登录页
              // 注意：带 _silent401 标记的「仅查询」接口（如查询当前用户/角色）不在此处
              // 强制登出——普通用户查询这些接口返回 401（无管理员权限）不应使已登录用户被登出。
              if (d && d.code === 401 && !opts._silent401) {
                try {
                  localStorage.removeItem('token');
                  localStorage.removeItem('user');
                  localStorage.removeItem('userRoles');
                  localStorage.removeItem('sysUserRaw');
                } catch(e) {}
                document.dispatchEvent(new Event('user:updated'));
                // 避免在登录页重复跳转
                if (location.pathname !== '/login') {
                  location.href = '/login?redirect=' + encodeURIComponent(location.pathname + location.search);
                }
                throw new Error('未登录或登录已过期');
              }
              return (d && d.data !== undefined) ? d.data : d;
            });
          });
        }
        // 统一安全 JSON 解析：空 body 或非 JSON 返回 null
        function safeJson(r) {
          return r.text().then(function(text) {
            if (!text || text.trim() === '') return null;
            try { return JSON.parse(text); } catch(e) { return null; }
          });
        }
        window.__api = {
          // 公开查询接口统一加 _silent401：即使返回 401（如后端对公开接口也做认证校验），
          // 也绝不强制登出已登录用户，避免「登录后切换页面/菜单时登录状态消失」。
          getWebConfig: function() { return api('/api/webConfig', { _silent401: true }).catch(function(){ return null; }); },
          getCarousels: function() { return api('/api/article/getCarousels', { _silent401: true }).then(function(d){ return Array.isArray(d) ? d : (d && d.list) || []; }).catch(function(){ return []; }); },
          getArticles: function(params) { return api('/api/article/list' + (params ? ('?' + new URLSearchParams(params).toString()) : ''), { _silent401: true }).then(function(d){ return Array.isArray(d) ? d : (d && d.list) || []; }).catch(function(){ return []; }); },
          getArticle: function(id) { return api('/api/article/detail/' + encodeURIComponent(id), { _silent401: true }).catch(function(){ return null; }); },
          searchArticles: function(kw, pageNum, pageSize) { return api('/api/article/list?keyword=' + encodeURIComponent(kw) + '&pageNum=' + (pageNum||1) + '&pageSize=' + (pageSize||10), { _silent401: true }).then(function(d){ if (Array.isArray(d)) return { list: d, total: d.length, pages: 1, current: 1 }; var records = (d && d.records) || (d && d.list) || []; return { list: records, total: (d && d.total) || records.length, pages: (d && d.pages) || 1, current: (d && d.current) || (pageNum||1) }; }).catch(function(){ return { list: [], total: 0, pages: 0, current: 1 }; }); },
          getArchive: function() { return api('/api/article/archive', { _silent401: true }).catch(function(){ return null; }); },
          // Comments（公开列表接口）
          getComments: function(postId) { return api('/api/comment/list?articleId=' + encodeURIComponent(postId), { _silent401: true }).then(function(d){ return Array.isArray(d) ? d : (d && (d.records || d.list)) || []; }).catch(function(){ return []; }); },
          addComment: function(data) { return api('/addComment', { method: 'POST', body: JSON.stringify(data) }); },
          // Messages（留言板）
          getMessages: function() { return api('/api/message/list', { _silent401: true }).then(function(d){ return Array.isArray(d) ? d : (d && (d.records || d.list)) || []; }).catch(function(){ return []; }); },
          // 新增留言：POST /api/message/add，字段 avatar/nickname/content/status
          addMessage: function(data) {
            var base = window.__API_BASE__ || '';
            var token = '';
            try { token = localStorage.getItem('token') || ''; } catch (e) {}
            return fetch(base + '/api/message/add', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Authorization': token },
              body: JSON.stringify(data),
              referrerPolicy: 'no-referrer-when-downgrade',
              credentials: 'include',
              mode: 'cors'
            }).then(safeJson).then(function(d) {
              // 成功返回 true；失败时抛错带后端 message
              if (d && d.code === 200) return d.data;
              var err = new Error((d && d.message) ? d.message : '留言失败');
              err.code = d ? d.code : 0;
              throw err;
            });
          },
          // Friends（友情链接）
          getFriends: function() { return api('/api/friend/list', { _silent401: true }).then(function(d){ return Array.isArray(d) ? d : (d && (d.records || d.list)) || []; }).catch(function(){ return []; }); },
          // 申请友链：POST /api/friend/apply，字段 name/url/info/avatar/email
          // 需登录；后端可能返回 code:500 + 业务 message（如"该网站已存在"），需透传给前端
          applyFriend: function(data) {
            var base = window.__API_BASE__ || '';
            var token = '';
            try { token = localStorage.getItem('token') || ''; } catch (e) {}
            return fetch(base + '/api/friend/apply', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Authorization': token },
              body: JSON.stringify(data),
              referrerPolicy: 'no-referrer-when-downgrade',
              credentials: 'include',
              mode: 'cors'
            }).then(safeJson).then(function(d) {
              // 成功返回 true；失败时抛错带后端 message
              if (d && d.code === 200) return d.data;
              var err = new Error((d && d.message) ? d.message : '申请失败');
              err.code = d ? d.code : 0;
              throw err;
            });
          },
          // User（_silent401：普通用户查询当前用户信息返回 401/403 时不应被强制登出）
          getMe: function() { return api('/api/user/me', { _silent401: true }).catch(function(){ return null; }); },
          login: function(data) {
            var base = window.__API_BASE__ || '';
            return fetch(base + '/auth/login', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
              referrerPolicy: 'no-referrer-when-downgrade',
              credentials: 'include',
              mode: 'cors'
            }).then(function(r) {
              // 先读取文本，避免空 body 时 r.json() 报错
              return r.text().then(function(text) {
                if (!text || text.trim() === '') {
                  throw new Error('后端返回空响应（状态码 ' + r.status + '，可能被安全策略拦截）');
                }
                try {
                  return JSON.parse(text);
                } catch (e) {
                  throw new Error('后端返回非 JSON 响应（状态码 ' + r.status + '）');
                }
              });
            }).then(function(d) {
              // 登录接口返回完整 JSON：{code, message, data}
              // 成功时 data 含 token 和用户信息；失败时 code 非 200
              if (d && d.code !== 200 && d.code !== 0) {
                throw new Error(d.message || '登录失败');
              }
              var result = (d && d.data !== undefined) ? d.data : d;
              if (!result || !result.token) {
                throw new Error(d.message || '未获取到登录凭证');
              }
              return result;
            });
          },
          // _silent401：普通用户查询角色/资料返回 401 不应被强制登出（checkAdminRole 依赖此接口）
          getProfile: function() { return api('/sys/user/profile', { _silent401: true }).catch(function(){ return null; }); },
          updateProfile: function(data) {
            return api('/protal/user/updateProfile', { method: 'PUT', body: JSON.stringify(data) }).catch(function() {
              return data;
            });
          },
          // 我的文章（分页+标题搜索）
          myArticle: function(pageNum, pageSize, title) {
            var q = 'pageNum=' + (pageNum||1) + '&pageSize=' + (pageSize||10);
            if (title) q += '&title=' + encodeURIComponent(title);
            return api('/protal/user/myArticle?' + q);
          },
          // 我的评论（分页+标题搜索）
          myComment: function(pageNum, pageSize, title) {
            var q = 'pageNum=' + (pageNum||1) + '&pageSize=' + (pageSize||10);
            if (title) q += '&title=' + encodeURIComponent(title);
            return api('/protal/user/comment?' + q);
          },
          // 我的回复（分页+标题搜索）
          myReply: function(pageNum, pageSize, title) {
            var q = 'pageNum=' + (pageNum||1) + '&pageSize=' + (pageSize||10);
            if (title) q += '&title=' + encodeURIComponent(title);
            return api('/protal/user/myReply?' + q);
          },
          // 我的点赞（分页+标题搜索）
          myLike: function(pageNum, pageSize, title) {
            var q = 'pageNum=' + (pageNum||1) + '&pageSize=' + (pageSize||10);
            if (title) q += '&title=' + encodeURIComponent(title);
            return api('/protal/user/myLike?' + q);
          },
          // 删除文章（后台接口 DELETE /sys/article/delete/{ids}，支持批量逗号分隔）
          delArticle: function(id) { return api('/sys/article/delete/' + encodeURIComponent(id), { method: 'DELETE' }); },
          // 新增文章 POST /sys/article/add，body 为文章对象
          addArticle: function(data) { return api('/sys/article/add', { method: 'POST', body: JSON.stringify(data) }); },
          // 修改文章 PUT /sys/article/update，body 为文章对象（含 id）
          updateArticle: function(data) { return api('/sys/article/update', { method: 'PUT', body: JSON.stringify(data) }); },
          // 统一保存：有 id 走更新，无 id 走新增
          // 新增/更新文章：有 id 走 PUT /sys/article/update，无 id 走 POST /sys/article/add
          // 需登录 + sys:article:add/update 权限；后端可能返回 code:500 + 业务 message，需透传给前端
          saveArticle: function(data) {
            var base = window.__API_BASE__ || '';
            var token = '';
            try { token = localStorage.getItem('token') || ''; } catch (e) {}
            var url = (data && data.id) ? '/sys/article/update' : '/sys/article/add';
            var method = (data && data.id) ? 'PUT' : 'POST';
            return fetch(base + url, {
              method: method,
              headers: { 'Content-Type': 'application/json', 'Authorization': token },
              body: JSON.stringify(data),
              referrerPolicy: 'no-referrer-when-downgrade',
              credentials: 'include',
              mode: 'cors'
            }).then(safeJson).then(function(d) {
              if (d && d.code === 200) return d.data;
              var err = new Error((d && d.message) ? d.message : '保存失败');
              err.code = d ? d.code : 0;
              throw err;
            });
          },
          // 后台文章详情（用于编辑回显，字段比门户接口更全）
          getAdminArticleDetail: function(id) { return api('/sys/article/detail/' + encodeURIComponent(id)); },
          // 图片上传（multipart/form-data，字段名 file），返回 URL 字符串
          uploadFile: function(file) {
            var fd = new FormData();
            fd.append('file', file);
            return api('/file/upload', { method: 'POST', body: fd });
          },
          // 文件删除：DELETE /file/delete?url=文件地址
          deleteFile: function(url) {
            var base = window.__API_BASE__ || '';
            var token = '';
            try { token = localStorage.getItem('token') || ''; } catch (e) {}
            return fetch(base + '/file/delete?url=' + encodeURIComponent(url), {
              method: 'DELETE',
              headers: { 'Authorization': token },
              referrerPolicy: 'no-referrer-when-downgrade',
              credentials: 'include',
              mode: 'cors'
            }).then(safeJson).then(function(d) {
              if (d && d.code === 200) return d.data;
              var err = new Error((d && d.message) ? d.message : '删除失败');
              err.code = d ? d.code : 0;
              throw err;
            });
          },
          // 分类列表（后台接口，门户接口返回空）
          getCategoryList: function() { return api('/sys/category/list').then(function(d){ return Array.isArray(d) ? d : (d && (d.records || d.list)) || []; }).catch(function(){ return []; }); },
          // 删除评论/回复（统一接口 /protal/user/delMyComment/{id}）
          delComment: function(id) { return api('/protal/user/delMyComment/' + encodeURIComponent(id), { method: 'DELETE' }); },
          // 删除回复（与评论统一接口 /protal/user/delMyComment/{id}）
          delReply: function(id) { return api('/protal/user/delMyComment/' + encodeURIComponent(id), { method: 'DELETE' }); },
          // 点赞/取消点赞：统一接口 GET /api/article/like/{id}，后端自动 toggle
          like: function(articleId) { return api('/api/article/like/' + encodeURIComponent(articleId)); },
          // 兼容旧调用：unlike 与 like 走同一 toggle 接口
          unlike: function(articleId) { return api('/api/article/like/' + encodeURIComponent(articleId)); },
          logout: function() { return api('/auth/logout', { method: 'POST' }).catch(function(){ return null; }); },
          isLoggedIn: function() { try { return !!localStorage.getItem('token'); } catch(e) { return false; } },
          getUser: function() { try { var u = localStorage.getItem('user'); return u ? JSON.parse(u) : null; } catch(e) { return null; } },
          clearAuth: function() { try { localStorage.removeItem('token'); localStorage.removeItem('user'); localStorage.removeItem('userRoles'); } catch(e) {} }
        };
        window.__webConfig = null;
        window.__api.getWebConfig().then(function(cfg) {
          if (!cfg) return;
          window.__webConfig = cfg;
          document.dispatchEvent(new CustomEvent('webconfig:updated', { detail: cfg }));
          if (cfg.name) document.title = document.title.replace(/ - [^-]+$/, ' - ' + cfg.name);
          if (cfg.logo) {
            var fav = document.getElementById('favicon-link');
            if (fav) fav.href = cfg.logo;
          }
        }).catch(function(){});
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark') document.documentElement.classList.add('dark');
          var g = localStorage.getItem('glass-mode');
          if (g === 'flat') document.documentElement.classList.add('flat');
        } catch(e) {}
      })();
    </script>

    <!-- 全局主题/风格切换事件委托（View Transitions 后事件监听器可能丢失，使用委托确保可靠） -->
    <script is:inline data-astro-rerun>
      (function() {
        // data-astro-rerun：每次页面加载及 View Transitions 导航时执行。
        // 每次导航都从 localStorage 重新应用主题/玻璃模式到 <html> 的 class，
        // 确保切换页面后深浅色与液态玻璃/平面风格全局保持一致，不因跳转/返回首页而恢复默认。
        function applySavedTheme() {
          try {
            var t = localStorage.getItem('theme');
            var g = localStorage.getItem('glass-mode');
            var html = document.documentElement;
            if (t === 'dark') html.classList.add('dark'); else html.classList.remove('dark');
            if (g === 'flat') html.classList.add('flat'); else html.classList.remove('flat');
          } catch (e) {}
        }
        applySavedTheme();
        function updateThemeUI(isDark) {
          document.querySelectorAll('.theme-icon-moon').forEach(function(el) { el.style.display = isDark ? 'none' : ''; });
          document.querySelectorAll('.theme-icon-sun').forEach(function(el) { el.style.display = isDark ? '' : 'none'; });
          var tv = document.getElementById('me-theme-value');
          if (tv) tv.textContent = isDark ? '深色' : '浅色';
        }
        function updateGlassUI(isFlat) {
          document.querySelectorAll('.glass-icon-flat').forEach(function(el) { el.style.display = isFlat ? 'none' : ''; });
          document.querySelectorAll('.glass-icon-glass').forEach(function(el) { el.style.display = isFlat ? '' : 'none'; });
          var gv = document.getElementById('me-glass-value');
          if (gv) gv.textContent = isFlat ? '平面' : '液态玻璃';
        }
        function triggerThemeAnim() {
          document.documentElement.classList.add('theme-animating');
          setTimeout(function() { document.documentElement.classList.remove('theme-animating'); }, 500);
        }
        function onThemeToggle() {
          var isDark = document.documentElement.classList.toggle('dark');
          try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch(e) {}
          updateThemeUI(isDark);
          triggerThemeAnim();
        }
        function onGlassToggle() {
          var isFlat = document.documentElement.classList.toggle('flat');
          try { localStorage.setItem('glass-mode', isFlat ? 'flat' : 'glass'); } catch(e) {}
          updateGlassUI(isFlat);
          // 与主题切换一致：切换液态玻璃/平面时平滑过渡背景色，避免手机端整体闪烁
          triggerThemeAnim();
        }
        function clickHandler(e) {
          var themeBtn = e.target.closest('#theme-toggle, #me-theme-item');
          if (themeBtn) { e.preventDefault(); e.stopPropagation(); onThemeToggle(); return; }
          var glassBtn = e.target.closest('#glass-toggle, #me-glass-item');
          if (glassBtn) { e.preventDefault(); e.stopPropagation(); onGlassToggle(); return; }
        }
        if (window.__globalToggleClickHandler) {
          document.removeEventListener('click', window.__globalToggleClickHandler, true);
        }
        window.__globalToggleClickHandler = clickHandler;
        // 使用 capture 阶段，确保即使子元素阻止冒泡也能响应
        document.addEventListener('click', clickHandler, true);
        updateThemeUI(document.documentElement.classList.contains('dark'));
        updateGlassUI(document.documentElement.classList.contains('flat'));
      })();
    </script>
  </head>
