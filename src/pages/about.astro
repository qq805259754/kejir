---
/**
 * 关于/我的页面
 * PC端：关于作者
 * 移动端：个人中心风格，头像+昵称+简介+菜单列表
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
---

<BaseLayout title="我的" description="关于作者" currentPath="/about">
  <div class="content-zone about-page">
    <!-- PC端：关于页面 -->
    <div class="about-pc">
      <div class="page-header">
        <h1>关于</h1>
        <p class="page-sub">关于作者</p>
      </div>

      <!-- 作者信息大卡片 -->
      <div class="glass-card about-hero" id="about-intro">
        <div class="about-hero-avatar">
          <div class="about-avatar" id="about-avatar">{siteConfig.author.charAt(0)}</div>
          <div class="about-avatar-ring"></div>
        </div>
        <div class="about-hero-info">
          <h2 id="about-author-name">{siteConfig.author}</h2>
          <div id="about-bio" class="about-hero-bio">{siteConfig.description}</div>
          <div class="about-hero-tags">
            <span class="hero-tag"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>创作者</span>
            <span class="hero-tag"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>科技爱好者</span>
          </div>
        </div>
      </div>

      <!-- 关于我 -->
      <div class="glass-card about-card">
        <h3>
          <span class="card-icon card-icon-info">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          </span>
          关于我
        </h3>
        <div class="about-me-content" id="about-me-content">加载中...</div>
      </div>

      <!-- 联系我 -->
      <div class="glass-card about-card">
        <h3>
          <span class="card-icon card-icon-contact">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </span>
          联系我
        </h3>
        <div class="about-contacts" id="about-contacts"></div>
      </div>
    </div>

    <!-- 移动端：我的页面 -->
    <div class="about-mobile">
      <!-- 用户信息头：默认不展示头像和昵称，登录后展示登录用户信息 -->
      <div class="me-header" id="me-header">
        <div class="me-avatar-wrap">
          <div class="me-avatar me-avatar-default" id="me-avatar">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </div>
        </div>
        <div class="me-info">
          <h2 id="me-name">未登录</h2>
          <p id="me-bio">登录后查看更多功能</p>
        </div>
      </div>

      <!-- 菜单分组 -->
      <div class="me-group" id="me-guest-group">
        <!-- 未登录：显示登录入口（点击展开内联登录表单） -->
        <a href="javascript:void(0)" class="me-item" id="me-login-item">
          <span class="me-icon me-icon-brand">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <span class="me-label">登录</span>
          <span class="me-arrow">›</span>
        </a>
        <!-- 内联登录表单（移动端） -->
        <div id="me-login-form" class="me-login-form" style="display:none;">
          <div class="me-login-error" id="me-login-error" style="display:none;"></div>
          <div class="me-login-field">
            <input type="text" id="me-login-username" placeholder="用户名 / 邮箱" autocomplete="username" />
          </div>
          <div class="me-login-field">
            <input type="password" id="me-login-password" placeholder="密码" autocomplete="current-password" />
          </div>
          <button type="button" class="me-login-submit" id="me-login-submit">登 录</button>
          <a href="/register" class="me-register-link">没有账号？立即注册</a>
        </div>
        <!-- 未登录：注册入口 -->
        <a href="/register" class="me-item">
          <span class="me-icon me-icon-green">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
          </span>
          <span class="me-label">注册</span>
          <span class="me-arrow">›</span>
        </a>
      </div>

      <!-- 已登录：与 PC 端个人中心一致的菜单 -->
      <div class="me-group" id="me-user-group" style="display:none;">
        <a href="/profile?from=me" class="me-item">
          <span class="me-icon me-icon-brand">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <span class="me-label">个人资料</span>
          <span class="me-arrow">›</span>
        </a>
        <a href="/change-password?from=me" class="me-item">
          <span class="me-icon me-icon-blue">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </span>
          <span class="me-label">修改密码</span>
          <span class="me-arrow">›</span>
        </a>
        <a href="/my-articles?from=me" class="me-item">
          <span class="me-icon me-icon-purple">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          </span>
          <span class="me-label">我的文章</span>
          <span class="me-arrow">›</span>
        </a>
        <a href="/my-comments?from=me" class="me-item">
          <span class="me-icon me-icon-blue">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <span class="me-label">我的评论</span>
          <span class="me-arrow">›</span>
        </a>
        <a href="/my-replies?from=me" class="me-item">
          <span class="me-icon me-icon-green">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
          </span>
          <span class="me-label">我的回复</span>
          <span class="me-arrow">›</span>
        </a>
        <a href="/my-likes?from=me" class="me-item">
          <span class="me-icon me-icon-pink">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </span>
          <span class="me-label">我的点赞</span>
          <span class="me-arrow">›</span>
        </a>
        <!-- 管理后台（仅管理员可见，点击跳转到 /admin?from=me） -->
        <a href="/admin?from=me" class="me-item" id="me-admin-item" style="display:none;">
          <span class="me-icon me-icon-brand">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          </span>
          <span class="me-label">管理后台</span>
          <span class="me-arrow">›</span>
        </a>
        <a href="javascript:void(0)" class="me-item" id="me-logout-item">
          <span class="me-icon me-icon-pink">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </span>
          <span class="me-label">退出登录</span>
          <span class="me-arrow">›</span>
        </a>
      </div>

      <div class="me-group">
        <a href="#" class="me-item" id="me-theme-item">
          <span class="me-icon me-icon-purple">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          </span>
          <span class="me-label">深浅模式</span>
          <span class="me-value" id="me-theme-value">浅色</span>
        </a>
        <a href="#" class="me-item" id="me-glass-item">
          <span class="me-icon me-icon-cyan">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </span>
          <span class="me-label">界面风格</span>
          <span class="me-value" id="me-glass-value">液态玻璃</span>
        </a>
      </div>

      <!-- 联系方式 — 横向网格布局 -->
      <div class="me-group me-group-contacts" id="me-contacts-group">
        <div class="me-group-title">联系方式</div>
        <div class="me-contacts-grid" id="me-contacts-grid"></div>
      </div>
    </div>
  </div>

</BaseLayout>

<style>
  .about-page { max-width: 720px; margin: 0 auto; }
  .about-mobile { display: none; }
  .about-pc .page-header { margin-bottom: 10px; }

  /* ===== PC 端卡片间距 ===== */
  .about-pc .glass-card { margin-bottom: 8px; padding: 14px 18px; }
  .about-pc .glass-card:last-child { margin-bottom: 0; }

  /* ===== PC 端作者大卡片 ===== */
  .about-hero {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 20px;
  }
  .about-hero-avatar {
    position: relative;
    flex-shrink: 0;
  }
  .about-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--accent-gradient);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
    z-index: 1;
    box-shadow: 0 6px 20px var(--accent-shadow), inset 1px 1px 2px rgba(255,255,255,0.3);
    border: 2px solid rgba(255,255,255,0.4);
  }
  .about-avatar img { width:100%; height:100%; object-fit: cover; }
  .about-avatar-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1px solid var(--brand-a20);
    animation: ring-pulse 3s ease-in-out infinite;
  }
  @keyframes ring-pulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.08); opacity: 0.2; }
  }
  .about-hero-info { flex: 1; min-width: 0; }
  .about-hero-info h2 {
    margin: 0 0 6px;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .about-hero-info p {
    margin: 0 0 10px;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .about-hero-bio {
    margin: 0 0 8px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .about-hero-bio p { margin: 0 0 6px; }
  .about-hero-bio p:last-child { margin-bottom: 0; }
  .about-hero-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    border-radius: 20px;
    background: var(--brand-a08);
    color: var(--brand);
    font-size: 0.72rem;
    font-weight: 500;
  }
  .flat .hero-tag { background: var(--bg-secondary); }

  /* ===== 通用卡片标题 ===== */
  .glass-card h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .card-icon {
    width: 28px;
    height: 28px;
    border-radius: 9px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: inset 0.5px 0.5px 1px rgba(255,255,255,0.3);
  }
  .card-icon-info {
    background: linear-gradient(135deg, rgba(0,210,211,0.20), rgba(0,180,216,0.10));
    color: #00d2d3;
  }
  .card-icon-contact {
    background: linear-gradient(135deg, rgba(79,172,254,0.20), rgba(0,198,251,0.10));
    color: #4facfe;
  }
  .glass-card p { margin: 0 0 5px; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7; }
  .glass-card p:last-child { margin-bottom: 0; }

  /* 关于我内容区 — 支持 HTML */
  .about-me-content {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .about-me-content p { margin: 0 0 4px; }
  .about-me-content p:last-child { margin-bottom: 0; }
  .about-me-content ul, .about-me-content ol { padding-left: 1.2em; margin: 2px 0; }
  .about-me-content li { margin-bottom: 1px; }
  .about-me-content strong { color: var(--text-primary); font-weight: 700; }
  .about-me-content a { color: var(--brand); text-decoration: underline; }
  .about-me-content img { max-width: 100%; border-radius: var(--r-md); }
  .about-me-content h1, .about-me-content h2, .about-me-content h3, .about-me-content h4 {
    color: var(--text-primary); font-weight: 700; margin: 8px 0 4px;
  }
  .about-me-content blockquote {
    border-left: 3px solid var(--brand);
    padding: 4px 12px; margin: 6px 0;
    background: var(--glass-bg-subtle);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
  }

  /* ===== PC 端联系卡片 — 容器（链接样式见全局块，因联系方式由 JS 动态生成） ===== */
  .about-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  /* ===== 移动端"我的"样式 ===== */
  @media (max-width: 768px) {
    .about-pc { display: none; }
    .about-mobile { display: block; width: 100%; }

    .me-header {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 4px 4px 18px;
      width: 100%;
      box-sizing: border-box;
      cursor: pointer;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
      transition: opacity 0.15s;
    }
    .me-header:active { opacity: 0.85; }
    .me-avatar-wrap {
      position: relative;
      flex-shrink: 0;
    }
    .me-avatar {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: var(--accent-gradient);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      font-weight: 700;
      flex-shrink: 0;
      box-shadow: 0 6px 24px var(--accent-shadow), inset 1px 1px 2px rgba(255,255,255,0.3);
      border: 2px solid rgba(255,255,255,0.4);
      overflow: hidden;
    }
    .me-avatar img { width:100%; height:100%; object-fit:cover; }
    .me-info { flex: 1; min-width: 0; }
    .me-info h2 { margin: 0 0 4px; font-size: 1.2rem; font-weight: 700; color: var(--text-primary); }
    .me-info p { margin: 0; font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    .me-group {
      background:
        radial-gradient(circle 120px at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.05), transparent 60%),
        linear-gradient(135deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%),
        var(--lg-bg);
      border: 1px solid var(--lg-border-subtle);
      border-radius: 16px;
      margin-bottom: 12px;
      overflow: hidden;
      backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate));
      -webkit-backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate));
      box-shadow:
        inset 1px 1px 0.5px rgba(255,255,255,0.18),
        inset -1px -1px 0.5px rgba(255,255,255,0.05),
        0 2px 8px rgba(0,0,0,0.04);
      width: 100%;
      position: relative;
    }
    .me-group::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
      opacity: 0.5;
      pointer-events: none;
    }
    .me-group-title {
      padding: 10px 16px 4px;
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .flat .me-group { backdrop-filter: none; -webkit-backdrop-filter: none; background: var(--bg-secondary); border-color: var(--border); box-shadow: none; }
    .flat .me-group::before { display: none; }
    .me-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      color: var(--text-primary);
      text-decoration: none;
      transition: background 0.15s;
      border-bottom: 1px solid var(--lg-border-subtle);
    }
    .me-item:last-child { border-bottom: none; }
    .me-item:active { background: rgba(255,255,255,0.05); }
    .flat .me-item { border-bottom-color: var(--border); }
    .flat .me-item:last-child { border-bottom: none; }

    /* 移动端图标 — 彩色玻璃风格 */
    .me-icon {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all var(--dur-fast);
    }
    .me-icon svg { width: 17px; height: 17px; }
    .me-item:active .me-icon { transform: scale(0.93); }
    .me-icon-me, .me-icon { background: linear-gradient(135deg, var(--brand-a18), var(--brand-a08)); color: var(--brand); }
    .me-icon-brand { background: linear-gradient(135deg, var(--brand-a20), var(--brand-a10)); color: var(--brand); }
    .me-icon-blue { background: linear-gradient(135deg, rgba(79,172,254,0.20), rgba(0,198,251,0.10)); color: #4facfe; }
    .me-icon-green { background: linear-gradient(135deg, rgba(7,193,96,0.18), rgba(45,198,83,0.08)); color: #07c160; }
    .me-icon-pink { background: linear-gradient(135deg, rgba(250,112,154,0.20), rgba(245,87,108,0.10)); color: #f06292; }
    .me-icon-purple { background: linear-gradient(135deg, rgba(156,100,255,0.20), rgba(126,87,255,0.10)); color: #9c64ff; }
    .me-icon-cyan { background: linear-gradient(135deg, rgba(0,210,211,0.20), rgba(0,180,216,0.10)); color: #00d2d3; }
    .flat .me-icon { background: var(--brand-a08); color: var(--brand); }

    .me-label {
      flex: 1;
      font-size: 0.93rem;
      font-weight: 500;
      color: var(--text-primary);
    }
