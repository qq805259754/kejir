---
/**
 * 注册页 - /register
 * 邮箱注册：昵称 + 邮箱 + 验证码 + 密码
 * 60s 倒计时，刷新页面保持倒计时状态
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="注册" description="用户注册">
  <div class="content-zone login-content-zone">
    <div class="login-wrapper">
      <div class="login-card glass-card">
        <!-- 顶部品牌区 -->
        <div class="auth-header">
          <div class="auth-logo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <h2 class="auth-title">创建账号</h2>
          <p class="auth-subtitle">通过邮箱验证码注册，开启你的旅程</p>
        </div>

        <!-- 注册表单 -->
        <form id="register-form" class="auth-form">
          <div class="form-group">
            <label for="register-nickname">昵称 <span class="req">*</span></label>
            <div class="auth-input-wrap">
              <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                <line x1="9" y1="9" x2="9.01" y2="9"/>
                <line x1="15" y1="9" x2="15.01" y2="9"/>
              </svg>
              <input id="register-nickname" type="text" name="nickname" placeholder="请输入昵称" required autocomplete="nickname" />
            </div>
          </div>

          <div class="form-group">
            <label for="register-email">邮箱地址 <span class="req">*</span></label>
            <div class="auth-input-wrap">
              <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <input id="register-email" type="email" name="email" placeholder="请输入邮箱地址" required autocomplete="email" />
            </div>
          </div>

          <div class="form-group">
            <label for="register-code">邮箱验证码 <span class="req">*</span></label>
            <div class="auth-code-row">
              <div class="auth-input-wrap auth-code-input-wrap">
                <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <input id="register-code" type="text" name="code" placeholder="请输入验证码" required autocomplete="one-time-code" />
              </div>
              <button type="button" id="btn-send-code" class="auth-code-btn">发送验证码</button>
            </div>
          </div>

          <div class="form-group">
            <label for="register-password">密码 <span class="req">*</span></label>
            <div class="auth-input-wrap">
              <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input id="register-password" type="password" name="password" placeholder="请输入密码（至少 6 位）" required autocomplete="new-password" />
            </div>
          </div>

          <button type="submit" class="glass-btn glass-btn-primary auth-submit-btn">注 册</button>
          <p id="register-error" class="auth-error" style="display:none;"></p>
          <p id="register-success" class="auth-success" style="display:none;"></p>
        </form>

        <!-- 底部登录链接 -->
        <div class="auth-footer">
          <span>已有账号？</span>
          <a href="/login" class="auth-register-link">立即登录</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .req { color: #e53e3e; margin-left: 2px; }

  .login-content-zone {
    justify-content: center;
    align-items: center;
  }

  .login-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    flex: 1;
    padding: var(--sp-4);
  }

  .login-card {
    max-width: 440px;
    width: 100%;
    padding: var(--sp-8);
    position: relative;
    overflow: hidden;
  }

  .auth-header {
    text-align: center;
    margin-bottom: var(--sp-6);
  }
  .auth-logo {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: var(--accent-gradient);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    margin-bottom: var(--sp-4);
    box-shadow: 0 8px 24px var(--accent-shadow);
    position: relative;
  }
  .auth-logo::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 24px;
    background: var(--accent-gradient);
    opacity: 0.2;
    z-index: -1;
    filter: blur(12px);
  }
  .auth-logo svg {
    width: 28px;
    height: 28px;
  }
  .auth-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 var(--sp-2);
    letter-spacing: -0.01em;
  }
  .auth-subtitle {
    font-size: 0.875rem;
    color: var(--text-tertiary);
    margin: 0;
  }

  .auth-form .form-group {
    margin-bottom: var(--sp-4);
  }
  .auth-form .form-group label {
    display: block;
    margin-bottom: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .auth-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .auth-input-icon {
    position: absolute;
    left: 14px;
    width: 18px;
    height: 18px;
    color: var(--text-tertiary);
    pointer-events: none;
    transition: color var(--dur-fast);
    z-index: 1;
  }
  .auth-form input[type="text"],
  .auth-form input[type="email"],
  .auth-form input[type="password"] {
    width: 100%;
    padding: 12px 14px 12px 42px;
    border-radius: var(--r-md);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    color: var(--text-primary);
    font-size: 0.9rem;
    font-family: inherit;
    transition: all var(--dur-fast) var(--ease-spring);
    outline: none;
    box-sizing: border-box;
  }
  .flat .auth-form input[type="text"],
  .flat .auth-form input[type="email"],
  .flat .auth-form input[type="password"] {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .auth-form input:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-a15);
    background: var(--glass-bg-strong);
  }
  .auth-input-wrap:focus-within .auth-input-icon {
    color: var(--brand);
  }
  .auth-form input::placeholder {
    color: var(--text-tertiary);
    font-weight: 400;
    opacity: 0.7;
  }

  /* 验证码行 */
  .auth-code-row {
    display: flex;
    gap: 10px;
    align-items: stretch;
  }
  .auth-code-input-wrap {
    flex: 1;
    min-width: 0;
  }
  .auth-code-input-wrap input {
    padding-right: 10px;
  }
  .auth-code-btn {
    flex-shrink: 0;
    padding: 0 16px;
    border-radius: var(--r-md);
    border: 1px solid var(--brand);
    background: var(--brand-a10);
    color: var(--brand);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
    min-width: 105px;
    text-align: center;
    font-family: inherit;
  }
  .auth-code-btn:hover:not(:disabled) {
    background: var(--brand-a18);
    border-color: var(--brand);
    transform: translateY(-1px);
  }
  .auth-code-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    border-color: var(--border);
    background: var(--lg-bg-subtle, rgba(120,120,120,0.06));
    color: var(--text-tertiary);
  }
  .flat .auth-code-btn {
    border-radius: 6px;
  }

  .auth-submit-btn {
    width: 100%;
    justify-content: center;
    margin-top: var(--sp-1);
    font-size: 0.95rem;
    padding: 12px 0;
    font-weight: 600;
    letter-spacing: 0.1em;
    border-radius: var(--r-md);
    min-height: 46px;
  }

  .auth-error {
    margin-top: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-md);
    background: rgba(239, 68, 68, 0.08);
    color: #ef4444;
    font-size: 0.82rem;
    line-height: 1.5;
    border: 1px solid rgba(239, 68, 68, 0.15);
  }

  .auth-success {
    margin-top: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-md);
    background: rgba(34, 197, 94, 0.08);
    color: #22c55e;
    font-size: 0.82rem;
    line-height: 1.5;
    border: 1px solid rgba(34, 197, 94, 0.15);
  }

  .auth-footer {
    text-align: center;
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--glass-border-subtle);
    font-size: 0.85rem;
    color: var(--text-tertiary);
  }
  .auth-register-link {
    color: var(--brand);
    font-weight: 600;
    text-decoration: none;
    margin-left: 4px;
    transition: opacity var(--dur-fast);
  }
  .auth-register-link:hover { opacity: 0.8; text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 640px) {
    .login-wrapper { padding: var(--sp-4) 0; }
    .login-card {
      width: 100%;
      max-width: 100%;
      padding: var(--sp-6) var(--sp-4);
      border-radius: var(--r-lg);
      animation: authCardIn 0.45s var(--ease-spring) both;
    }
    .auth-code-row { flex-direction: column; }
    .auth-code-btn { width: 100%; padding: 10px 0; }
  }

  @keyframes authCardIn {
    from { opacity: 0; transform: translateY(18px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script is:inline data-astro-rerun>
  (function() {
    var form = document.getElementById('register-form');
    var errorEl = document.getElementById('register-error');
    var successEl = document.getElementById('register-success');
    var sendBtn = document.getElementById('btn-send-code');
    var emailInput = document.getElementById('register-email');

    // ===== 倒计时管理（持久化到 localStorage） =====
    var COUNTDOWN_KEY = 'register_email_code_countdown';
    var COUNTDOWN_DURATION = 60; // 60 秒

    function getCountdownEnd() {
      try {
        var val = localStorage.getItem(COUNTDOWN_KEY);
        return val ? parseInt(val, 10) : 0;
      } catch(e) { return 0; }
    }

    function setCountdownEnd(endTime) {
      try {
        localStorage.setItem(COUNTDOWN_KEY, String(endTime));
      } catch(e) {}
    }

    function clearCountdown() {
      try {
        localStorage.removeItem(COUNTDOWN_KEY);
      } catch(e) {}
    }

    function getRemainingSeconds() {
      var endTime = getCountdownEnd();
      if (!endTime) return 0;
      var now = Date.now();
      var remaining = Math.ceil((endTime - now) / 1000);
      return remaining > 0 ? remaining : 0;
    }

    function updateCountdownUI() {
      var remaining = getRemainingSeconds();
      if (remaining > 0 && sendBtn) {
        sendBtn.disabled = true;
        sendBtn.textContent = remaining + 's 后重发';
        // 如果倒计时结束但还没被清除，清除它
        if (remaining <= 0) {
          clearCountdown();
          if (sendBtn) {
            sendBtn.disabled = false;
            sendBtn.textContent = '发送验证码';
          }
          return;
        }
        // 每秒更新一次
        setTimeout(function() {
          updateCountdownUI();
        }, 1000);
      } else {
        clearCountdown();
        if (sendBtn) {
          sendBtn.disabled = false;
          sendBtn.textContent = '发送验证码';
        }
      }
    }

    function startCountdown() {
      var endTime = Date.now() + COUNTDOWN_DURATION * 1000;
      setCountdownEnd(endTime);
      updateCountdownUI();
    }

    // 页面加载时恢复倒计时
    updateCountdownUI();

    // ===== 错误/成功提示 =====
    function showError(msg) {
      if (errorEl) {
        errorEl.textContent = msg;
        errorEl.style.display = 'block';
      }
      if (successEl) successEl.style.display = 'none';
    }
    function hideError() {
      if (errorEl) errorEl.style.display = 'none';
    }
    function showSuccess(msg) {
      if (successEl) {
        successEl.textContent = msg;
        successEl.style.display = 'block';
      }
      if (errorEl) errorEl.style.display = 'none';
    }

    // ===== 发送验证码 =====
    if (sendBtn) {
      sendBtn.addEventListener('click', function() {
        var email = (emailInput ? emailInput.value.trim() : '');
        if (!email) {
          showError('请先输入邮箱地址');
          emailInput && emailInput.focus();
          return;
        }
        // 邮箱格式校验
        var emailReg = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailReg.test(email)) {
          showError('邮箱格式不正确');
          emailInput && emailInput.focus();
          return;
        }

        hideError();
        sendBtn.disabled = true;
        sendBtn.textContent = '发送中...';

        fetch('/api/sendEmailCode?email=' + encodeURIComponent(email), {
          method: 'GET',
          credentials: 'include',
          referrerPolicy: 'no-referrer-when-downgrade',
          mode: 'cors'
        }).then(function(res) {
          return res.text().then(function(text) {
            if (!text || text.trim() === '') return { code: 200 };
            try { return JSON.parse(text); } catch(e) { return { code: 200 }; }
          }).then(function(body) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return body;
          }).catch(function() {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return { code: 200 };
          });
        }).then(function(res) {
          if (res && res.code !== undefined && res.code !== 200 && res.code !== 0) {
            throw new Error(res.message || '发送失败');
          }
          showSuccess('验证码已发送至 ' + email + '，请查收邮箱');
          startCountdown();
        }).catch(function(err) {
          showError(err.message || '发送失败，请检查网络后重试');
          sendBtn.disabled = false;
          sendBtn.textContent = '发送验证码';
        });
      });
    }

    // ===== 表单提交 =====
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        hideError();
        if (successEl) successEl.style.display = 'none';

        var data = new FormData(form);
        var nickname = (data.get('nickname') || '').trim();
        var email = (data.get('email') || '').trim();
        var code = (data.get('code') || '').trim();
        var password = data.get('password') || '';

        // 必填校验
        if (!nickname || !email || !code || !password) {
          showError('所有字段均为必填项，请完整填写');
          return;
        }
        // 邮箱格式校验
        var emailReg = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailReg.test(email)) {
          showError('邮箱格式不正确');
          return;
        }
        // 密码长度校验
        if (password.length < 6) {
          showError('密码长度至少为 6 位');
          return;
        }

        var submitBtn = form.querySelector('.auth-submit-btn');
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '注册中...'; }

        // 调用 /api/email/register 接口注册
        fetch('/api/email/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          referrerPolicy: 'no-referrer-when-downgrade',
          credentials: 'include',
          mode: 'cors',
          body: JSON.stringify({
            nickname: nickname,
            email: email,
            password: password,
            code: code
          })
        }).then(function(res) {
          return res.text().then(function(text) {
            if (!text || text.trim() === '') return { code: -1, message: '响应解析失败' };
            try { return JSON.parse(text); } catch(e) { return { code: -1, message: '响应解析失败' }; }
          });
        }).then(function(res) {
          if (res && res.code === 200) {
            showSuccess('注册成功！即将跳转登录页...');
            // 清除倒计时
            clearCountdown();
            setTimeout(function() {
              window.location.href = '/login';
            }, 1500);
          } else {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = '注 册'; }
            var msg = '注册失败，请稍后重试';
            if (res && res.message) msg = res.message;
            showError(msg);
          }
        }).catch(function(err) {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = '注 册'; }
          var msg = '注册失败，请检查网络后重试';
          if (err && err.message) msg = err.message;
          showError(msg);
        });
      });
    }
  })();
</script>