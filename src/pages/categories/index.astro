---
/**
 * 分类页 - 按主题浏览文章
 * 布局：app-container 内部 grid（sidebar | topbar | content-zone | side | footer）
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getAllCategories } from '../../data/posts';

const currentPath = '/categories';

const categories = getAllCategories();
const catMeta: Record<string, { emoji: string; desc: string }> = {
  'AI': { emoji: '🤖', desc: '大模型、机器学习、深度学习与AI应用前沿' },
  '芯片': { emoji: '💾', desc: '半导体工艺、处理器架构、GPU与AI芯片解析' },
  '移动': { emoji: '📱', desc: '智能手机、平板、可穿戴设备评测与行业动态' },
  '开发': { emoji: '💻', desc: '编程语言、框架、工程实践与开发者生态' },
  '开源': { emoji: '🔓', desc: '开源项目、社区动态、开源协议与商业化探索' },
  '云计算': { emoji: '☁️', desc: '云原生、Serverless、容器与分布式系统' },
};

const allPosts = getAllPosts();
const recentPosts = allPosts.slice(0, 6).map(p => ({
  slug: p.slug, title: p.title, excerpt: p.excerpt, date: p.date, category: p.category,
}));
---

<BaseLayout title="文章分类" description="按主题浏览科技热的所有文章分类">
  <div class="content-zone">
      <div class="page-hero">
        <h1>文章分类</h1>
        <p>按主题浏览科技内容，发现你感兴趣的领域</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:var(--sp-4);">
        {categories.map((c) => {
          const meta = catMeta[c.name] || { emoji: '📂', desc: `${c.name} 相关文章` };
          return (
            <a href={`/category/${encodeURIComponent(c.name)}`} class="glass-card cat-page-card" data-reveal>
              <div class="cat-emoji">{meta.emoji}</div>
              <h3>{c.name}</h3>
              <span class="cat-count-label">{c.count} 篇文章</span>
              <p>{meta.desc}</p>
            </a>
          );
        })}
      </div>
    </div>
</BaseLayout>

<style>
  .cat-page-card { padding: var(--sp-5); text-decoration: none; transition: all var(--dur-normal) var(--ease-out); display: block; }
  .cat-page-card:hover { transform: translateY(-3px); }
  .cat-emoji {
    font-size: 2rem;
    width: 52px; height: 52px;
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--r-md);
    background: var(--glass-bg-subtle);
    border: 1px solid var(--glass-border-subtle);
    margin-bottom: var(--sp-2);
  }
  .cat-page-card h3 { font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin: 0 0 var(--sp-1) 0; }
  .cat-count-label { font-size: 0.75rem; font-weight: 600; color: var(--brand); text-transform: uppercase; letter-spacing: 0.04em; }
  .cat-page-card p { font-size: 0.8125rem; color: var(--text-secondary); margin: var(--sp-1) 0 0 0; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
