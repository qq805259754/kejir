    }

    function loadArticle() {
      if (!window.__api) { setTimeout(loadArticle, 50); return; }
      var id = extractId();
      if (!id) return;
      window.__api.getArticle(id).then(function(data) {
        if (data) {
          applyArticle(data);
          loadComments(id);
        } else {
          // 文章数据为空时仍初始化点赞按钮（使用 URL 中的 id）
          initLikeButton(id);
          loadComments(id);
        }
      }).catch(function() {
        initLikeButton(id);
        loadComments(id);
      });
    }

    // ====== 点赞功能 ======
