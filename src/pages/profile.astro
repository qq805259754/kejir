---
/**
 * 个人中心 - /profile
 * 包含主菜单视图和个人资料编辑视图，通过前端切换
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="个人中心" description="个人中心">
  <!-- 未登录引导 -->
  <div id="profile-guest" data-reveal style="text-align:center;padding:var(--sp-10);border-radius:var(--r-lg);background:var(--lg-bg);border:var(--lg-border-width) solid var(--lg-border);backdrop-filter:blur(var(--lg-blur)) saturate(var(--lg-saturate));-webkit-backdrop-filter:blur(var(--lg-blur)) saturate(var(--lg-saturate));box-shadow:var(--lg-shadow);">
    <div style="width:80px;height:80px;border-radius:50%;background:var(--accent-gradient);margin:0 auto var(--sp-5);display:flex;align-items:center;justify-content:center;color:#fff;font-size:2rem;font-weight:800;">?</div>
    <h2 style="margin-bottom:var(--sp-2);">登录后查看个人中心</h2>
    <p style="color:var(--text-tertiary);margin-bottom:var(--sp-6);">登录后可管理你的文章、评论、点赞等</p>
    <div style="display:flex;gap:var(--sp-3);justify-content:center;">
      <a href="/login?redirect=/profile" class="glass-btn glass-btn-primary">立即登录</a>
      <a href="/" class="glass-btn glass-btn-ghost">返回首页</a>
    </div>
  </div>

  <!-- 已登录视图 -->
  <div id="profile-logged" style="display:none;">

    <!-- ========== 主菜单视图 ========== -->
    <div id="profile-main-view">
      <!-- 用户头部信息 -->
      <div class="profile-header" data-reveal>
        <div class="profile-avatar-big" id="profile-avatar">U</div>
        <div class="profile-info">
          <h2 id="profile-name">用户</h2>
          <p id="profile-subtitle">欢迎回来</p>
        </div>
      </div>

      <!-- 功能菜单 -->
      <div class="profile-menu">
        <a href="javascript:void(0)" class="profile-menu-item" id="menu-edit-profile" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          个人资料
        </a>
        <a href="/change-password?from=profile" class="profile-menu-item" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          修改密码
        </a>
        <a href="/my-articles?from=profile" class="profile-menu-item" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          我的文章
        </a>
        <a href="/my-comments?from=profile" class="profile-menu-item" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          我的评论
        </a>
        <a href="/my-replies?from=profile" class="profile-menu-item" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
          我的回复
        </a>
        <a href="/my-likes?from=profile" class="profile-menu-item" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          我的点赞
        </a>
        <a href="/admin?from=profile" class="profile-menu-item" id="profile-admin-link" style="display:none;" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          管理后台
        </a>
        <button class="profile-menu-item danger" id="profile-logout" type="button" data-reveal>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          退出登录
        </button>
      </div>
    </div>

    <!-- ========== 个人资料编辑视图 ========== -->
    <div id="profile-edit-view" style="display:none;">
      <!-- 返回按钮 + 标题 -->
      <div class="edit-view-header" data-reveal>
        <button class="back-btn" id="edit-back-btn" type="button" aria-label="返回">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          返回
        </button>
        <h3 class="edit-view-title">个人资料</h3>
      </div>

      <!-- 编辑表单 -->
      <div class="profile-edit-card" data-reveal>
        <div class="profile-edit-form" id="profile-edit-form">
          <!-- 昵称 -->
          <div class="form-field">
            <label class="form-label" for="edit-nickname">昵称</label>
            <input class="form-input" type="text" id="edit-nickname" placeholder="请输入昵称" autocomplete="nickname" />
          </div>

          <!-- 邮箱 -->
          <div class="form-field">
            <label class="form-label" for="edit-email">邮箱</label>
            <input class="form-input" type="email" id="edit-email" placeholder="请输入邮箱" autocomplete="email" />
          </div>

          <!-- 性别 -->
          <div class="form-field">
            <label class="form-label">性别</label>
            <div class="radio-group" id="edit-sex-group">
              <label class="radio-item">
                <input type="radio" name="sex" value="1" id="sex-male" />
                <span class="radio-label">男</span>
              </label>
              <label class="radio-item">
                <input type="radio" name="sex" value="0" id="sex-female" />
                <span class="radio-label">女</span>
              </label>
              <label class="radio-item">
                <input type="radio" name="sex" value="2" id="sex-secret" />
                <span class="radio-label">保密</span>
              </label>
            </div>
          </div>

          <!-- 个人简介 -->
          <div class="form-field">
            <label class="form-label" for="edit-bio">个人简介</label>
            <textarea class="form-textarea" id="edit-bio" rows="3" placeholder="介绍一下自己吧" maxlength="200"></textarea>
          </div>

          <!-- 提示信息 -->
          <div class="form-msg" id="profile-form-msg" style="display:none;"></div>

          <!-- 操作按钮 -->
          <div class="form-actions">
            <button class="glass-btn glass-btn-primary" id="profile-save-btn" type="button">修改</button>
            <button class="glass-btn glass-btn-ghost" id="profile-reset-btn" type="button">重置</button>
          </div>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  /* 返回按钮 + 标题 */
  .edit-view-header {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-5);
  }
  .back-btn {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 14px;
    border-radius: 10px;
    border: 1px solid var(--lg-border);
    background: var(--lg-bg);
    backdrop-filter: blur(var(--lg-blur));
    -webkit-backdrop-filter: blur(var(--lg-blur));
    color: var(--text-primary);
    font-size: 0.84rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  .flat .back-btn {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: var(--surface);
    border-color: var(--border);
  }
  .back-btn:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .edit-view-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* 个人资料编辑卡片 */
  .profile-edit-card {
    border-radius: var(--r-lg);
    padding: var(--sp-6);
    margin-bottom: var(--sp-6);
    background: var(--lg-bg);
    border: var(--lg-border-width) solid var(--lg-border);
    backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate));
    -webkit-backdrop-filter: blur(var(--lg-blur)) saturate(var(--lg-saturate));
    box-shadow: var(--lg-shadow);
  }
  .flat .profile-edit-card {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: var(--surface);
    border-color: var(--border);
  }

  /* 表单字段 */
  .profile-edit-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .form-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .form-input {
    padding: 11px 14px;
    border-radius: 10px;
    border: 1px solid var(--lg-border);
    background: var(--lg-bg);
    backdrop-filter: blur(var(--lg-blur));
    -webkit-backdrop-filter: blur(var(--lg-blur));
    font-size: 0.88rem;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    width: 100%;
  }
  .flat .form-input {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: var(--bg-secondary);
    border-color: var(--border);
  }
  .form-input:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-a15);
  }
  .form-input::placeholder {
    color: var(--text-tertiary);
  }
  .form-textarea {
    padding: 11px 14px;
    border-radius: 10px;
    border: 1px solid var(--lg-border);
    background: var(--lg-bg);
    backdrop-filter: blur(var(--lg-blur));
    -webkit-backdrop-filter: blur(var(--lg-blur));
    font-size: 0.88rem;
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
    width: 100%;
    resize: vertical;
    font-family: inherit;
    line-height: 1.6;
  }
  .flat .form-textarea {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: var(--bg-secondary);
    border-color: var(--border);
  }
  .form-textarea:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-a15);
  }
  .form-textarea::placeholder {
    color: var(--text-tertiary);
  }

  /* 性别单选 */
  .radio-group {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .radio-item {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    padding: 8px 16px;
    border-radius: 10px;
    border: 1px solid var(--lg-border);
    background: var(--lg-bg);
    transition: all 0.2s;
    user-select: none;
  }
  .flat .radio-item {
    background: var(--bg-secondary);
    border-color: var(--border);
  }
  .radio-item:hover {
    border-color: var(--brand-a30);
  }
  .radio-item input[type="radio"] {
    appearance: none;
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--lg-border);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    flex-shrink: 0;
  }
  .flat .radio-item input[type="radio"] {
    border-color: var(--border);
  }
  .radio-item input[type="radio"]:checked {
    border-color: var(--brand);
    background: var(--brand);
  }
  .radio-item input[type="radio"]:checked::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
  }
  .radio-item:has(input:checked) {
    border-color: var(--brand);
    background: var(--brand-a10);
  }
  .radio-label {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  /* 提示信息 */
  .form-msg {
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.82rem;
    text-align: center;
  }
  .form-msg.success {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
  }
  .form-msg.error {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
  }

  /* 操作按钮 */
  .form-actions {
    display: flex;
    gap: var(--sp-3);
    margin-top: var(--sp-2);
  }
  .form-actions .glass-btn {
    flex: 1;
    justify-content: center;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .profile-edit-card {
      padding: var(--sp-4);
    }
    .radio-group {
      gap: var(--sp-2);
    }
    .radio-item {
      padding: 7px 12px;
    }
    .form-actions {
      flex-direction: column;
    }
  }
</style>

<script is:inline data-astro-rerun>
  (function () {
    var guest = document.getElementById('profile-guest');
    var logged = document.getElementById('profile-logged');
    var mainView = document.getElementById('profile-main-view');
    var editView = document.getElementById('profile-edit-view');
    var avatar = document.getElementById('profile-avatar');
    var nameEl = document.getElementById('profile-name');
    var subtitleEl = document.getElementById('profile-subtitle');
    var adminLink = document.getElementById('profile-admin-link');
    var logoutBtn = document.getElementById('profile-logout');
    var menuEditProfile = document.getElementById('menu-edit-profile');
    var backBtn = document.getElementById('edit-back-btn');

    // 表单元素
    var inputNickname = document.getElementById('edit-nickname');
    var inputEmail = document.getElementById('edit-email');
    var inputBio = document.getElementById('edit-bio');
    var sexGroup = document.getElementById('edit-sex-group');
    var saveBtn = document.getElementById('profile-save-btn');
    var resetBtn = document.getElementById('profile-reset-btn');
    var formMsg = document.getElementById('profile-form-msg');

    // 保存原始数据用于重置
    var originalData = null;

    function getUser() {
      try { var u = localStorage.getItem('user'); return u ? JSON.parse(u) : null; } catch (e) { return null; }
    }
    function getToken() {
      try { return localStorage.getItem('token'); } catch (e) { return null; }
    }
    function saveUser(u) {
      try { localStorage.setItem('user', JSON.stringify(u)); } catch(e) {}
    }

    // 将性别值映射到 radio
    function setSexRadio(sex) {
      var val = String(sex);
      var radios = sexGroup ? sexGroup.querySelectorAll('input[name="sex"]') : [];
      for (var i = 0; i < radios.length; i++) {
        radios[i].checked = radios[i].value === val;
      }
    }

    // 获取当前选中的性别
    function getSexRadio() {
      var checked = sexGroup ? sexGroup.querySelector('input[name="sex"]:checked') : null;
      return checked ? checked.value : '2';
    }

    // 填充表单
    function fillForm(data) {
      originalData = {
        nickname: data.nickname || data.username || '',
        email: data.email || '',
        sex: String(data.sex !== undefined ? data.sex : 2),
        bio: data.bio || data.summary || data.signature || ''
      };
      if (inputNickname) inputNickname.value = originalData.nickname;
      if (inputEmail) inputEmail.value = originalData.email;
      if (inputBio) inputBio.value = originalData.bio;
      setSexRadio(originalData.sex);
    }

    // 显示提示
    function showMsg(msg, type) {
      if (!formMsg) return;
      formMsg.textContent = msg;
      formMsg.className = 'form-msg ' + (type || '');
      formMsg.style.display = 'block';
      setTimeout(function() { formMsg.style.display = 'none'; }, 3000);
    }

    // 切换视图
    function showMainView() {
      if (mainView) mainView.style.display = '';
      if (editView) editView.style.display = 'none';
    }
    function showEditView() {
      // 进入编辑视图前重新填充表单（确保使用最新数据）
      fillForm(getUser() || {});
      if (mainView) mainView.style.display = 'none';
      if (editView) editView.style.display = '';
    }

    // 从 profile 接口加载完整用户数据
    function loadProfile() {
      if (!window.__api || !window.__api.getProfile) {
        fillForm(getUser() || {});
        return;
      }
      window.__api.getProfile().then(function(data) {
        if (!data) {
          fillForm(getUser() || {});
          return;
        }
        // profile 接口返回 { sysUser: {...}, roles: [...] }
        var userData = data.sysUser || data;
        // 更新 localStorage 中的角色信息
        if (data.roles) {
          try { localStorage.setItem('userRoles', JSON.stringify(data.roles)); } catch(e) {}
        }
        // 合并用户数据到 localStorage
        var localUser = getUser() || {};
        var merged = Object.assign({}, localUser, {
          id: userData.id || localUser.id,
          username: userData.username || localUser.username,
          nickname: userData.nickname || localUser.nickname,
          email: userData.email || localUser.email,
          avatar: userData.avatar || localUser.avatar,
          sex: userData.sex !== undefined ? userData.sex : localUser.sex,
          bio: userData.summary || userData.signature || userData.bio || localUser.bio || ''
        });
        saveUser(merged);
        // 保存完整 sysUser 对象用于更新接口
        try { localStorage.setItem('sysUserRaw', JSON.stringify(userData)); } catch(e) {}
        fillForm(merged);
        render();
        checkAdmin(data.roles);
      }).catch(function() {
        fillForm(getUser() || {});
      });
    }

    // 检查管理员角色
    function checkAdmin(roles) {
      if (!roles) {
        try { roles = JSON.parse(localStorage.getItem('userRoles') || '[]'); } catch(e) { roles = []; }
      }
      var isAdmin = false;
      if (Array.isArray(roles)) {
        for (var i = 0; i < roles.length; i++) {
          var r = typeof roles[i] === 'string' ? roles[i] : (roles[i].roleName || roles[i].name || '');
          if (r.indexOf('超级管理员') >= 0 || r === 'admin' || r === 'ADMIN') { isAdmin = true; break; }
        }
      }
      if (adminLink && isAdmin) adminLink.style.display = 'flex';
    }

    function render() {
      var token = getToken();
      if (!token) {
        if (guest) guest.style.display = 'block';
        if (logged) logged.style.display = 'none';
        return;
      }
      if (guest) guest.style.display = 'none';
      if (logged) logged.style.display = 'block';
      var user = getUser() || { nickname: '用户' };
      var name = user.nickname || user.username || user.name || '用户';
      if (avatar) {
        if (user.avatar) {
          avatar.innerHTML = '<img src="' + user.avatar + '" alt="头像" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" onerror="this.style.display=\'none\';this.parentNode.textContent=\'' + name.charAt(0).toUpperCase() + '\'" />';
        } else {
          avatar.textContent = name.charAt(0).toUpperCase();
        }
      }
      if (nameEl) nameEl.textContent = name;
      if (subtitleEl) subtitleEl.textContent = user.email || '欢迎回来';
    }

    // 点击"个人资料"菜单 -> 切换到编辑视图
    if (menuEditProfile) {
      menuEditProfile.addEventListener('click', function(e) {
        e.preventDefault();
        showEditView();
      });
    }

    // 点击返回按钮 -> 回到主菜单视图
    if (backBtn) {
      backBtn.addEventListener('click', function() {
        showMainView();
      });
    }

    // 保存按钮
    if (saveBtn) {
      saveBtn.addEventListener('click', function() {
        var nickname = inputNickname ? inputNickname.value.trim() : '';
        var email = inputEmail ? inputEmail.value.trim() : '';
        var sex = parseInt(getSexRadio(), 10);
        var bio = inputBio ? inputBio.value.trim() : '';

        if (!nickname) {
          showMsg('请输入昵称', 'error');
          return;
        }
        if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showMsg('邮箱格式不正确', 'error');
          return;
        }

        saveBtn.disabled = true;
        saveBtn.textContent = '保存中...';

        // 构建完整请求体：以原始 sysUser 为基础，覆盖编辑字段
        var rawUser = {};
        try { rawUser = JSON.parse(localStorage.getItem('sysUserRaw') || '{}'); } catch(e) {}
        var user = getUser() || {};
        var profileData = Object.assign({}, rawUser, {
          nickname: nickname,
          email: email,
          sex: sex,
          bio: bio,
          id: rawUser.id || user.id,
          username: rawUser.username || user.username,
          avatar: rawUser.avatar || user.avatar || '',
          summary: bio
        });

        if (window.__api && window.__api.updateProfile) {
          window.__api.updateProfile(profileData).then(function(res) {
            var user = getUser() || {};
            user.nickname = nickname;
            user.email = email;
            user.sex = sex;
            user.bio = bio;
            user.summary = bio;
            saveUser(user);
            originalData = { nickname: nickname, email: email, sex: String(sex), bio: bio };
            document.dispatchEvent(new Event('user:updated'));
            render();
            saveBtn.disabled = false;
            saveBtn.textContent = '修改';
            showMsg('个人资料修改成功', 'success');
          }).catch(function() {
            var user = getUser() || {};
            user.nickname = nickname;
            user.email = email;
            user.sex = sex;
            user.bio = bio;
            user.summary = bio;
            saveUser(user);
            originalData = { nickname: nickname, email: email, sex: String(sex), bio: bio };
            document.dispatchEvent(new Event('user:updated'));
            render();
            saveBtn.disabled = false;
            saveBtn.textContent = '修改';
            showMsg('个人资料已保存', 'success');
          });
        } else {
          var user = getUser() || {};
          user.nickname = nickname;
          user.email = email;
          user.sex = sex;
          user.bio = bio;
          user.summary = bio;
          saveUser(user);
          originalData = { nickname: nickname, email: email, sex: String(sex), bio: bio };
          document.dispatchEvent(new Event('user:updated'));
          render();
          saveBtn.disabled = false;
          saveBtn.textContent = '修改';
          showMsg('个人资料已保存', 'success');
        }
      });
    }

    // 重置按钮
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        if (originalData) {
          if (inputNickname) inputNickname.value = originalData.nickname;
          if (inputEmail) inputEmail.value = originalData.email;
          if (inputBio) inputBio.value = originalData.bio;
          setSexRadio(originalData.sex);
          showMsg('已重置为原始数据', 'success');
        }
      });
    }

    // 退出登录
    if (logoutBtn) {
      logoutBtn.addEventListener('click', function () {
        if (window.__api) {
          window.__api.logout().then(function() {
            window.__api.clearAuth();
            document.dispatchEvent(new Event('user:updated'));
            window.location.href = '/login';
          }).catch(function() {
            window.__api.clearAuth();
            document.dispatchEvent(new Event('user:updated'));
            window.location.href = '/login';
          });
        } else {
          try { localStorage.removeItem('token'); localStorage.removeItem('user'); } catch (e) {}
          document.dispatchEvent(new Event('user:updated'));
          window.location.href = '/login';
        }
      });
    }

    // 初始化
    render();
    setTimeout(function() {
      if (getToken()) loadProfile();
    }, 300);
    window.addEventListener('storage', render);
    document.addEventListener('user:updated', render);
  })();
</script>
