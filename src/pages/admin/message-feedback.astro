---
/**
 * 管理后台 - 反馈管理 - /admin/message-feedback
 * API: GET    /sys/feedback/list?pageNum&pageSize&title
 *      GET    /sys/feedback/{id}（详情）
 *      PUT    /sys/feedback/update（body: {id, status, reply}）
 *      DELETE /sys/feedback/delete/{ids}（支持批量逗号分隔）
 * 操作：查看 / 回复（弹窗）/ 删除；无新增
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/admin.css';
---

<BaseLayout title="反馈管理" description="反馈管理" currentPath="/admin">
  <div class="content-zone admin-page">
    <!-- 返回链接 -->
    <a href="/admin" class="admin-back-link">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      返回管理后台
    </a>

    <!-- 页面标题 -->
    <div class="page-header">
      <h1>反馈管理</h1>
      <p class="page-sub">查看用户反馈并回复，支持按标题搜索</p>
    </div>

    <!-- 搜索栏 -->
    <div class="admin-search-bar" id="search-bar">
      <div class="admin-search-field">
        <label for="search-type">反馈类型</label>
        <select class="glass-input" id="search-type">
          <option value="">全部类型</option>
          <option value="1">Bug反馈</option>
          <option value="2">功能建议</option>
          <option value="3">投诉</option>
          <option value="4">咨询</option>
          <option value="5">其他</option>
        </select>
      </div>
      <div class="admin-search-field">
        <label for="search-status">状态</label>
        <select class="glass-input" id="search-status">
          <option value="">全部状态</option>
          <option value="0">待处理</option>
          <option value="1">处理中</option>
          <option value="2">已处理</option>
        </select>
      </div>
      <button class="glass-btn glass-btn-primary glass-btn-sm" id="btn-search" type="button">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        搜索
      </button>
      <button class="glass-btn glass-btn-ghost glass-btn-sm" id="btn-reset" type="button">重置</button>
      <button class="glass-btn glass-btn-ghost glass-btn-sm" id="btn-refresh" type="button">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        刷新
      </button>
    </div>

    <!-- 工具栏 -->
    <div class="admin-toolbar">
      <button class="glass-btn glass-btn-ghost glass-btn-sm" id="btn-batch-del" type="button">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        批量删除
      </button>
    </div>

    <!-- 表格容器 -->
    <div id="table-container"></div>

    <!-- 分页容器 -->
    <div id="pagination-container"></div>
  </div>
</BaseLayout>

<script is:inline src="/scripts/admin.js"></script>
<script is:inline data-astro-rerun>
  (function () {
    function ready(fn) {
      if (window.Admin) return fn();
      setTimeout(function () { ready(fn); }, 50);
    }
    ready(init);

    function init() {
      var Admin = window.Admin;
      var tableContainer = document.getElementById('table-container');
      var paginationContainer = document.getElementById('pagination-container');
      var inputType = document.getElementById('search-type');
      var inputStatus = document.getElementById('search-status');
      var btnSearch = document.getElementById('btn-search');
      var btnReset = document.getElementById('btn-reset');
      var btnRefresh = document.getElementById('btn-refresh');
      var btnBatchDel = document.getElementById('btn-batch-del');

      // ===== 登录检查 =====
      if (!Admin.isLoggedIn()) {
        location.href = '/login?redirect=' + encodeURIComponent(location.pathname + location.search);
        return;
      }

      var state = {
        pageNum: 1,
        pageSize: (window.__DEFAULT_PAGE_SIZE__ || 10),
        total: 0,
        loading: false,
        selectedIds: [],
        query: { type: '', status: '' },
      };

      // ===== 工具：头像 =====
      function avatar(src, alt) {
        if (!src) return '<span style="color:var(--text-tertiary);font-size:0.8rem;">无</span>';
        return '<img src="' + Admin.esc(src) + '" alt="' + Admin.esc(alt || '') + '" style="width:34px;height:34px;border-radius:50%;object-fit:cover;vertical-align:middle;" onerror="this.style.display=\'none\'" />';
      }

      // ===== 工具：单行截断 =====
      function ellipsis(text, max, extraStyle) {
        var s = text == null ? '' : String(text);
        return '<div style="max-width:' + (max || 240) + 'px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;' + (extraStyle || '') + '" title="' + Admin.esc(s) + '">' + Admin.esc(s) + '</div>';
      }

      // ===== 反馈类型徽章 =====
      var typeMap = { 1: 'Bug反馈', 2: '功能建议', 3: '投诉', 4: '咨询', 5: '其他' };
      function typeBadge(val) {
        var label = typeMap[Number(val)] || (val || '-');
        return Admin.badge(label, 'info');
      }

      // ===== 状态徽章：0待处理 / 1处理中 / 2已处理 =====
      function statusBadge(val) {
        var s = Number(val);
        if (s === 0) return Admin.badge('待处理', 'warning');
        if (s === 1) return Admin.badge('处理中', 'info');
        if (s === 2) return Admin.badge('已处理', 'success');
        return Admin.badge('未知', 'default');
      }

      // ===== 列配置 =====
      var columns = [
        { type: 'checkbox' },
        { title: '反馈人', render: function (row) {
            return '<div style="display:flex;align-items:center;gap:8px;">' +
              avatar(row.avatar, row.nickname) +
              '<span>' + Admin.esc(row.nickname || '-') + '</span></div>';
          } },
        { title: '反馈类型', align: 'center', render: function (row) { return typeBadge(row.type); } },
        { title: '反馈内容', render: function (row) { return ellipsis(row.content, 280); } },
        { title: '联系邮箱', render: function (row) {
            return row.email ? '<span style="font-family:var(--font-mono);font-size:0.8rem;">' + Admin.esc(row.email) + '</span>' : '<span style="color:var(--text-tertiary);">-</span>';
          } },
        { title: '回复内容', render: function (row) { return ellipsis(row.replyContent, 200); } },
        { title: '状态', align: 'center', render: function (row) { return statusBadge(row.status); } },
        { title: '创建时间', render: function (row) { return Admin.formatDate(row.createTime, true); } },
        { title: '操作', align: 'center', render: function (row) {
            return '<span class="col-actions">' +
              '<button type="button" class="act-view" data-action="view" data-id="' + Admin.esc(row.id) + '">查看</button>' +
              '<button type="button" class="act-edit" data-action="reply" data-id="' + Admin.esc(row.id) + '">回复</button>' +
              '<button type="button" class="act-del" data-action="delete" data-id="' + Admin.esc(row.id) + '">删除</button>' +
              '</span>';
          } },
      ];

      // ===== 加载列表 =====
      function loadList() {
        if (state.loading) return;
        state.loading = true;
        Admin.showLoading(tableContainer);
        var params = {
          pageNum: state.pageNum,
          pageSize: state.pageSize,
          source: 'admin',
        };
        if (state.query.type) params.type = state.query.type;
        if (state.query.status !== '') params.status = state.query.status;
        Admin.api.get('/sys/feedback/list', params).then(function (data) {
          state.loading = false;
          var page = Admin.getPageRecords(data);
          // 当前页为空且非首页：直接跳到最后一页
          if (page.list.length === 0 && state.pageNum > 1) {
            var tp = Math.ceil(page.total / state.pageSize) || 1;
            state.pageNum = Math.min(state.pageNum - 1, tp);
            if (state.pageNum < 1) state.pageNum = 1;
            return loadList();
          }
          state.total = page.total;
          renderTableData(page.list);
          renderPager();
        }).catch(function (err) {
          state.loading = false;
          Admin.showError(tableContainer, err.message);
        });
      }

      function renderTableData(list) {
        Admin.renderTable(tableContainer, columns, list, {
          emptyText: '暂无反馈数据',
          onSelectionChange: function (ids) { state.selectedIds = ids; },
        });
      }

      function renderPager() {
        Admin.renderPagination(paginationContainer, {
          current: state.pageNum,
          pageSize: state.pageSize,
          total: state.total,
          onChange: function (pageNum, pageSize) {
            state.pageNum = pageNum;
            state.pageSize = pageSize;
            loadList();
          },
        });
      }

      // ===== 搜索 / 重置 =====
      function doSearch() {
        state.query.type = inputType.value;
        state.query.status = inputStatus.value;
        state.pageNum = 1;
        loadList();
      }

      function doReset() {
        inputType.value = '';
        inputStatus.value = '';
        state.query.type = '';
        state.query.status = '';
        state.pageNum = 1;
        loadList();
      }

      // ===== 删除（单条） =====
      function handleDelete(id) {
        Admin.confirm('确定要删除该反馈吗？', function () {
          Admin.api.del('/sys/feedback/delete/' + encodeURIComponent(id)).then(function () {
            Admin.toast('删除成功', 'success');
            loadList();
          }).catch(function (err) {
            Admin.toast(err.message || '删除失败', 'error');
          });
        });
      }

      // ===== 批量删除 =====
      function handleBatchDelete() {
        var ids = state.selectedIds;
        if (!ids || ids.length === 0) {
          Admin.toast('请先选择要删除的反馈', 'info');
          return;
        }
        Admin.confirm('确定要删除选中的 ' + ids.length + ' 条反馈吗？', function () {
          Admin.api.del('/sys/feedback/delete/' + encodeURIComponent(ids.join(','))).then(function () {
            Admin.toast('批量删除成功', 'success');
            state.selectedIds = [];
            loadList();
          }).catch(function (err) {
            Admin.toast(err.message || '批量删除失败', 'error');
          });
        });
      }

      // ===== 查看 / 回复弹窗 =====
      function openFeedbackModal(id) {
        Admin.api.get('/sys/feedback/' + encodeURIComponent(id)).then(function (detail) {
          if (!detail) {
            Admin.toast('未获取到反馈详情', 'error');
            return;
          }
          var status = Number(detail.status);
          var statusHtml = status === 1 ? Admin.badge('已处理', 'success') : Admin.badge('待处理', 'warning');

          var body =
            '<div class="admin-form-group">' +
              '<label>反馈人</label>' +
              '<div class="fb-detail-value">' + Admin.esc(detail.nickname || '-') + '</div>' +
            '</div>' +
            '<div class="admin-form-group">' +
              '<label>反馈类型</label>' +
              '<div class="fb-detail-value">' + typeBadge(detail.type) + '</div>' +
            '</div>' +
            '<div class="admin-form-group">' +
              '<label>反馈内容</label>' +
              '<div class="fb-detail-content">' + Admin.esc(detail.content || '-') + '</div>' +
            '</div>' +
            '<div class="admin-form-row">' +
              '<div class="admin-form-group">' +
                '<label>联系邮箱</label>' +
                '<div class="fb-detail-value">' + Admin.esc(detail.email || '-') + '</div>' +
              '</div>' +
              '<div class="admin-form-group">' +
                '<label>当前状态</label>' +
                '<div class="fb-detail-value">' + statusHtml + '</div>' +
              '</div>' +
            '</div>' +
            '<div class="admin-form-group">' +
              '<label>创建时间</label>' +
              '<div class="fb-detail-value">' + Admin.formatDate(detail.createTime, true) + '</div>' +
            '</div>' +
            '<div class="admin-form-group">' +
              '<label for="fb-reply">回复内容</label>' +
              '<textarea class="glass-input" id="fb-reply" name="replyContent" placeholder="请输入回复内容">' + Admin.esc(detail.replyContent || '') + '</textarea>' +
            '</div>' +
            '<div class="admin-form-group">' +
              '<label for="fb-status">处理状态</label>' +
              '<select class="glass-input" id="fb-status" name="status">' +
                '<option value="0"' + (status === 0 ? ' selected' : '') + '>待处理</option>' +
                '<option value="1"' + (status === 1 ? ' selected' : '') + '>处理中</option>' +
                '<option value="2"' + (status === 2 ? ' selected' : '') + '>已处理</option>' +
              '</select>' +
            '</div>';

          var footer =
            '<button type="button" class="glass-btn glass-btn-ghost glass-btn-sm" data-modal-close>取消</button>' +
            '<button type="button" class="glass-btn glass-btn-primary glass-btn-sm" id="fb-save">保存回复</button>';

          Admin.openModal({
            title: '反馈详情',
            body: body,
            footer: footer,
            onOpen: function (modal) {
              var saveBtn = modal.querySelector('#fb-save');
              if (!saveBtn) return;
              saveBtn.addEventListener('click', function () {
                var reply = modal.querySelector('#fb-reply').value;
                var statusVal = Number(modal.querySelector('#fb-status').value);
                saveBtn.disabled = true;
                var oldText = saveBtn.textContent;
                saveBtn.textContent = '保存中...';
                Admin.api.put('/sys/feedback/update', {
                  id: detail.id,
                  status: statusVal,
                  replyContent: reply,
                }).then(function () {
                  Admin.toast('回复成功', 'success');
                  Admin.closeModal();
                  loadList();
                }).catch(function (err) {
                  Admin.toast(err.message || '回复失败', 'error');
                  saveBtn.disabled = false;
                  saveBtn.textContent = oldText;
                });
              });
            },
          });
        }).catch(function (err) {
          Admin.toast(err.message || '加载详情失败', 'error');
        });
      }

      // ===== 事件绑定 =====
      // 表格操作按钮（事件委托）
      tableContainer.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-action]');
        if (!btn) return;
        var action = btn.getAttribute('data-action');
        var id = btn.getAttribute('data-id');
        if (action === 'delete') handleDelete(id);
        else if (action === 'view' || action === 'reply') openFeedbackModal(id);
      });

      btnSearch.addEventListener('click', doSearch);
      btnReset.addEventListener('click', doReset);
      btnRefresh.addEventListener('click', function () { loadList(); });
      btnBatchDel.addEventListener('click', handleBatchDelete);
      // 回车搜索
      inputType.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') doSearch();
      });

      // ===== 启动 =====
      loadList();
    }
  })();
</script>

<style is:global>
  /* 反馈详情弹窗内的只读字段展示 */
  .fb-detail-value {
    padding: 8px 14px;
    border-radius: var(--r-sm, 8px);
    background: var(--lg-bg-subtle, var(--surface));
    border: 1px solid var(--lg-border-subtle, var(--border));
    font-size: 0.88rem;
    color: var(--text-primary);
    word-break: break-word;
    line-height: 1.6;
  }
  .flat .fb-detail-value {
    background: var(--surface);
    border-color: var(--border);
  }
  .fb-detail-content {
    padding: 10px 14px;
    border-radius: var(--r-sm, 8px);
    background: var(--lg-bg-subtle, var(--surface));
    border: 1px solid var(--lg-border-subtle, var(--border));
    font-size: 0.88rem;
    color: var(--text-primary);
    line-height: 1.7;
    max-height: 160px;
    overflow-y: auto;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .flat .fb-detail-content {
    background: var(--surface);
    border-color: var(--border);
  }
</style>
