<script is:inline data-astro-rerun>
  (function() {
    function escHtml(s) {
      if (s == null) return '';
      return String(s).replace(/[&<>"']/g, function(c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    var contactIcons = {
      github: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
      gitee: '<path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.99 3.65 9.13 8.44 9.88v-6.99H8v-2.89h2.44V9.85c0-2.41 1.44-3.74 3.63-3.74 1.05 0 2.15.19 2.15.19v2.37h-1.21c-1.19 0-1.56.74-1.56 1.5v1.8H16l-.43 2.89h-2.12V22C18.35 21.13 22 16.99 22 12z"/>',
      email: '<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
      qqNumber: '<path d="M12 2.5c-3.2 0-5.8 2.5-5.8 5.6 0 1.2.4 2.3 1 3.2-1.4 1.7-2.3 3.9-2.3 6.2 0 2.7 2 4.5 4.6 4.5h5c2.6 0 4.6-1.8 4.6-4.5 0-2.3-.9-4.5-2.3-6.2.6-.9 1-2 1-3.2 0-3.1-2.6-5.6-5.8-5.6z" fill="#fff" stroke="none"/><ellipse cx="12" cy="14" rx="3.2" ry="4.5" fill="#1296db" stroke="none" opacity=".15"/><circle cx="10.2" cy="7" r="1" fill="#fff" stroke="none"/><circle cx="13.8" cy="7" r="1" fill="#fff" stroke="none"/><circle cx="10.4" cy="7.2" r=".42" fill="#1296db" stroke="none"/><circle cx="13.6" cy="7.2" r=".42" fill="#1296db" stroke="none"/><path d="M10.8 8.3L12 9.8l1.2-1.5z" fill="#FFA500" stroke="none"/><path d="M7.8 10.2c1.3.7 2.7 1 4.2 1s2.9-.3 4.2-1c.2.9.3 1.7.3 2.6-1.4.5-2.9.8-4.5.8s-3.1-.3-4.5-.8c0-.9.1-1.7.3-2.6z" fill="#E74C3C" stroke="none" opacity=".75"/><path d="M9.5 17.5c-.3.5-.5 1.2-.5 1.8M14.5 17.5c.3.5.5 1.2.5 1.8" fill="none" stroke="#fff" stroke-width="1.2" stroke-linecap="round" opacity=".3"/>',
      wechat: '<path d="M8.5 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm7 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/><path d="M12 2C6.48 2 2 5.58 2 10c0 2.35 1.3 4.45 3.36 5.92L4.5 19l3.4-1.7c1.24.44 2.62.7 4.1.7 5.52 0 10-3.58 10-8s-4.48-8-10-8z"/>'
    };
    var contactLabels = { github:'GitHub', gitee:'Gitee', email:'邮箱', qqNumber:'QQ', wechat:'微信' };

    function setAvatar(el, avatar, name) {
      if (!el || !avatar) return;
      el.innerHTML = '<img src="' + avatar + '" alt="' + (name||'') + '" />';
      var img = el.querySelector('img');
      img.onerror = function() { el.innerHTML = (name||'A').charAt(0); };
    }

    function isMobileUA() {
      return /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    }

    function buildContactLink(k, value) {
      if (!value) return '';
      if (k === 'email') return 'mailto:' + value;
      if (k === 'qqNumber') {
        if (isMobileUA()) return 'mqqwpa://im/chat?chat_type=wpa&uin=' + encodeURIComponent(value);
        return 'tencent://message/?uin=' + value;
      }
      if (k === 'wechat') {
        // 移动端优先跳转微信 app；桌面端保留原链接（可能是公众号/二维码链接）
        if (isMobileUA()) return 'weixin://';
        return value;
      }
      return value;
    }

    // 从配置对象中提取联系方式值，兼容顶层字段与嵌套结构（webSite.contact / contact / setting）
    function pickContact(cfg, key) {
      if (!cfg) return '';
      if (cfg[key]) return cfg[key];
      // 嵌套结构兼容
      var sub = cfg.webSite || cfg.contact || cfg.setting || cfg.webConfig || {};
      return sub[key] || '';
    }

    function renderContacts(cfg, container, mobile) {
      if (!container) return;
      // 联系方式数据源：从 /api/webConfig（cfg）获取，兼容顶层与嵌套结构
      var contacts = { github:'', gitee:'', email:'', wechat:'', qqNumber:'' };
      Object.keys(contacts).forEach(function(k) {
        contacts[k] = pickContact(cfg, k) || '';
      });
      var html = '';
      var order = ['github', 'gitee', 'email', 'wechat', 'qqNumber'];
      order.forEach(function(k) {
        var v = contacts[k];
        if (!v) return;
        var link = buildContactLink(k, v);
        var iconSvg = '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">' + contactIcons[k] + '</svg>';
        var extraAttr = (k === 'wechat' && isMobileUA()) ? ' data-wechat-id="' + escHtml(v) + '"' : '';
        html += '<a href="'+link+'" target="_blank" rel="noopener" class="c-'+k+'"' + extraAttr + '>'
          + '<span class="contact-icon">' + iconSvg + '</span>'
          + '<span class="contact-label">' + contactLabels[k] + '</span></a>';
      });
      if (html) {
        container.innerHTML = html;
        container.style.display = '';
      } else if (mobile) {
        container.innerHTML = '<div class="contact-empty">暂无联系方式</div>';
        container.style.display = '';
      } else {
        container.innerHTML = '';
      }
    }

    // 移动端点击微信图标时，尝试打开微信并提示微信号
    if (window.__aboutWechatHandler) {
      document.removeEventListener('click', window.__aboutWechatHandler);
    }
    window.__aboutWechatHandler = function(e) {
      var link = e.target.closest('a.c-wechat');
      if (!link) return;
      var id = link.getAttribute('data-wechat-id');
      if (!id) return;
      if (isMobileUA()) {
        e.preventDefault();
        // 尝试唤起微信
        window.location.href = 'weixin://';
        // 友好提示，方便用户复制微信号
        setTimeout(function() {
          if (window.__showToast) {
            window.__showToast('已尝试打开微信，如未跳转请手动搜索微信号：' + id, 'success');
          }
        }, 800);
      }
    };
    document.addEventListener('click', window.__aboutWechatHandler);

    function applyConfig(cfg) {
      if (!cfg) return;
      var name = cfg.author || cfg.name || '作者';
      var avatar = cfg.authorAvatar || '';
      var bio = cfg.description || cfg.bio || '';

      ['about-author-name'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.textContent = name;
      });

      // authorInfo：支持纯文本和 HTML 格式，替换默认简介
      ['about-bio'].forEach(function(id) {
        var el = document.getElementById(id);
        if (!el) return;
        var authorInfo = cfg.authorInfo || '';
        if (authorInfo) {
          // 检测是否包含 HTML 标签
          if (/<[a-z][\s\S]*>/i.test(authorInfo)) {
            el.innerHTML = authorInfo;
          } else {
            el.textContent = authorInfo;
          }
        } else if (bio) {
          el.textContent = bio;
        }
      });

      // aboutMe：支持 HTML 格式，替换默认关于内容
      var aboutMeEl = document.getElementById('about-me-content');
      if (aboutMeEl) {
        var aboutMe = cfg.aboutMe || '';
        if (aboutMe) {
          // 检测是否包含 HTML 标签
          if (/<[a-z][\s\S]*>/i.test(aboutMe)) {
            aboutMeEl.innerHTML = aboutMe;
            // 清理空段落和多余换行
            aboutMeEl.querySelectorAll('p').forEach(function(p) {
              if (!p.textContent.trim() && !p.querySelector('img,br,hr')) p.remove();
            });
            aboutMeEl.querySelectorAll('br').forEach(function(br) {
              if (!br.nextSibling || !br.nextSibling.textContent || !br.nextSibling.textContent.trim()) {
                if (br.parentElement && br.parentElement.tagName === 'P' && !br.parentElement.textContent.trim()) {
                  br.parentElement.remove();
                }
              }
            });
          } else {
            aboutMeEl.innerHTML = aboutMe.split(/\n\n+/).map(function(p) {
              return '<p>' + escHtml(p).replace(/\n/g, '<br>') + '</p>';
            }).join('');
          }
        } else {
          aboutMeEl.innerHTML = '<p>暂无介绍</p>';
        }
      }

      ['about-avatar'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el && avatar) setAvatar(el, avatar, name);
      });
      renderContacts(cfg, document.getElementById('about-contacts'), false);
      renderContacts(cfg, document.getElementById('me-contacts-grid'), true);
    }

    var themeValue = document.getElementById('me-theme-value');
    var glassValue = document.getElementById('me-glass-value');
    function updateLabels() {
      if (themeValue) themeValue.textContent = document.documentElement.classList.contains('dark') ? '深色' : '浅色';
      if (glassValue) glassValue.textContent = document.documentElement.classList.contains('flat') ? '平面' : '液态玻璃';
    }
    updateLabels();
    // 主题/风格切换统一由 BaseLayout 事件委托处理，避免重复监听导致二次切换

    // 标签按钮（移动端 我的页面）
    document.querySelectorAll('.me-tag-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tag = btn.getAttribute('data-tag');
        if (tag) window.location.href = '/?tag=' + encodeURIComponent(tag);
      });
    });

    // 移动端"我的"页面：检查登录状态
    function checkMeAuthStatus() {
      var loggedIn = window.__api && window.__api.isLoggedIn();
      var user = window.__api ? window.__api.getUser() : null;
      var guestGroup = document.getElementById('me-guest-group');
      var userGroup = document.getElementById('me-user-group');
      var loginForm = document.getElementById('me-login-form');
      var adminItem = document.getElementById('me-admin-item');
      var meName = document.getElementById('me-name');
      var meAvatar = document.getElementById('me-avatar');
      var meBio = document.getElementById('me-bio');

      if (loggedIn && user) {
        // 已登录：隐藏游客菜单，显示用户菜单
        if (guestGroup) guestGroup.style.display = 'none';
        if (loginForm) loginForm.style.display = 'none';
        if (userGroup) userGroup.style.display = '';
        // 更新头部用户信息
        if (meName) meName.textContent = user.nickname || user.username || '已登录';
        if (meBio) meBio.textContent = user.email || user.signature || '欢迎回来';
        if (meAvatar) {
          meAvatar.classList.remove('me-avatar-default');
          if (user.avatar) {
            meAvatar.innerHTML = '<img src="' + user.avatar + '" alt="头像" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" onerror="this.style.display=\'none\'" />';
          } else {
            meAvatar.textContent = (user.nickname || user.username || 'U').charAt(0);
          }
        }
        // 检查管理员角色
        checkMeAdmin(user, adminItem);
      } else {
        // 未登录：显示游客菜单，隐藏用户菜单
        if (guestGroup) guestGroup.style.display = '';
        if (loginForm) loginForm.style.display = 'none';
        if (userGroup) userGroup.style.display = 'none';
        // 头部恢复默认状态
        if (meName) meName.textContent = '未登录';
        if (meBio) meBio.textContent = '登录后查看更多功能';
        if (meAvatar) {
          meAvatar.classList.add('me-avatar-default');
          meAvatar.innerHTML = '<svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
        }
      }
    }

    // 检查移动端管理员角色：通过 getProfile 获取 roles（与 PC 端 profile 页一致）
    function checkMeAdmin(user, adminItem) {
      if (!adminItem) return;
      // 先从 localStorage 缓存判断
      var roles = [];
      try { roles = JSON.parse(localStorage.getItem('userRoles') || '[]'); } catch(e) {}
      if (isAdminRole(roles)) { adminItem.style.display = ''; return; }
      // 缓存没有，调 getProfile 接口获取（与 PC 端 profile 页用同一接口）
      if (window.__api && typeof window.__api.getProfile === 'function') {
        window.__api.getProfile().then(function(data) {
          if (!data) return;
          var r = data.roles || [];
          try { localStorage.setItem('userRoles', JSON.stringify(r)); } catch(e) {}
          if (isAdminRole(r)) adminItem.style.display = '';
        }).catch(function() {});
      }
    }
    function isAdminRole(roles) {
      if (!roles || !Array.isArray(roles)) return false;
      for (var i = 0; i < roles.length; i++) {
        var r = typeof roles[i] === 'string' ? roles[i] : (roles[i].roleName || roles[i].name || '');
        if (r.indexOf('超级管理员') >= 0 || r === 'admin' || r === 'ADMIN') return true;
      }
      return false;
    }

    // 移动端内联登录：点击"登录"或"未登录"区域展开/收起表单
    var meLoginItem = document.getElementById('me-login-item');
    var meLoginForm = document.getElementById('me-login-form');
    var meHeader = document.getElementById('me-header');
    function toggleLoginForm(show) {
      if (!meLoginForm) return;
      if (typeof show === 'boolean') {
        meLoginForm.style.display = show ? 'flex' : 'none';
      } else {
        meLoginForm.style.display = meLoginForm.style.display === 'none' ? 'flex' : 'none';
      }
    }
    function closeLoginForm() {
      if (meLoginForm) meLoginForm.style.display = 'none';
    }
    if (meLoginItem) {
      meLoginItem.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        toggleLoginForm();
      });
    }
    // 点击"未登录"头部也可展开登录表单，提升可发现性
    if (meHeader) {
      meHeader.style.cursor = 'pointer';
      meHeader.style.webkitTapHighlightColor = 'transparent';
      meHeader.addEventListener('click', function(e) {
        // 避免点击头像/昵称时与表单内元素冲突
        if (e.target.closest('#me-login-form')) return;
        e.preventDefault();
        e.stopPropagation();
        toggleLoginForm(true);
      });
    }
    // 点击页面空白处（非登录表单/非登录入口）关闭表单，但不会隐藏登录/注册按钮
    if (window.__aboutLoginCloseHandler) {
      document.removeEventListener('click', window.__aboutLoginCloseHandler);
    }
    window.__aboutLoginCloseHandler = function(e) {
      if (!meLoginForm || meLoginForm.style.display === 'none') return;
      if (e.target.closest('#me-login-form') || e.target.closest('#me-login-item') || e.target.closest('#me-header')) return;
      closeLoginForm();
    };
    document.addEventListener('click', window.__aboutLoginCloseHandler);
    // 阻止表单内部点击冒泡到 document 关闭处理器
    if (meLoginForm) {
      meLoginForm.addEventListener('click', function(e) { e.stopPropagation(); });
    }

    // 移动端内联登录提交
    var meLoginSubmit = document.getElementById('me-login-submit');
    if (meLoginSubmit) {
      meLoginSubmit.addEventListener('click', function() {
        var username = document.getElementById('me-login-username').value.trim();
        var password = document.getElementById('me-login-password').value.trim();
        var errorEl = document.getElementById('me-login-error');
        if (!username || !password) {
          if (errorEl) { errorEl.textContent = '请输入用户名和密码'; errorEl.style.display = 'block'; }
          return;
        }
        meLoginSubmit.disabled = true;
        meLoginSubmit.textContent = '登录中...';
        if (errorEl) errorEl.style.display = 'none';
        window.__api.login({
          nickname: '',
          password: password,
          source: 'PC',
          username: username
        }).then(function(res) {
          if (res && res.token) {
            localStorage.setItem('token', res.token);
            var user = {
              id: res.id,
              username: res.username || username,
              nickname: res.nickname || res.username || username,
              avatar: res.avatar || res.avatarUrl || ''
            };
            localStorage.setItem('user', JSON.stringify(user));
            document.dispatchEvent(new Event('user:updated'));
            checkMeAuthStatus();
          } else {
            meLoginSubmit.disabled = false;
            meLoginSubmit.textContent = '登 录';
            if (errorEl) { errorEl.textContent = '登录失败，请检查用户名和密码'; errorEl.style.display = 'block'; }
          }
        }).catch(function(err) {
          meLoginSubmit.disabled = false;
          meLoginSubmit.textContent = '登 录';
          if (errorEl) { errorEl.textContent = (err && err.message) ? err.message : '登录失败，请稍后重试'; errorEl.style.display = 'block'; }
        });
      });
    }
    // 退出登录
    var meLogout = document.getElementById('me-logout-item');
    if (meLogout) {
      meLogout.addEventListener('click', function(e) {
        e.preventDefault();
        if (window.__api) {
          window.__api.logout().then(function() {
            window.__api.clearAuth();
            document.dispatchEvent(new Event('user:updated'));
            checkMeAuthStatus();
          }).catch(function() {
            window.__api.clearAuth();
            document.dispatchEvent(new Event('user:updated'));
            checkMeAuthStatus();
          });
        }
      });
    }

    // 监听用户状态更新
    document.addEventListener('user:updated', checkMeAuthStatus);
    // 初始化检查 — 延迟执行确保 DOM 和 API 均就绪
    setTimeout(function() {
      if (window.__api) {
        checkMeAuthStatus();
      } else {
        document.addEventListener('DOMContentLoaded', checkMeAuthStatus);
      }
    }, 100);

    function loadWebConfig() {
      if (window.__webConfig) {
        applyConfig(window.__webConfig);
        return;
      }
      if (window.__api && typeof window.__api.getWebConfig === 'function') {
        window.__api.getWebConfig().then(function(cfg) {
          if (cfg) applyConfig(cfg);
          else {
            // 接口返回空：显示空态占位，不展示错误数据
            renderContacts(null, document.getElementById('me-contacts-grid'), true);
          }
        }).catch(function() {
          // 接口失败：显示空态占位，避免手机端联系方式区域空白异常
          renderContacts(null, document.getElementById('me-contacts-grid'), true);
        });
      }
    }
    // 联系方式完全由 /api/webConfig 驱动（webConfig 到达后通过 applyConfig 渲染）
    if (window.__webConfig) applyConfig(window.__webConfig);
    document.addEventListener('webconfig:updated', function(e) { applyConfig(e.detail); });
    loadWebConfig();
    // View Transitions 页面切换后重新应用配置，避免联系方式因 DOM 重载丢失
    document.addEventListener('astro:page-load', function() {
      if (window.__webConfig) applyConfig(window.__webConfig);
    });
  })();
</script>
