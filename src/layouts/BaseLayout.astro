    <script is:inline data-astro-rerun>
      // 全局确认弹窗 — 替代原生 confirm()
      // data-astro-rerun：View Transitions 切换页面后 confirm-modal 元素会被替换，
      // 此脚本需随之重新执行并重新获取元素引用，否则旧引用指向已脱离 DOM 的元素，
      // 导致点击删除/取消等按钮时确认弹窗不显示（表现为「点击无反应」）。
      (function() {
        // 每次执行都实时获取元素，确保拿到当前 DOM 中有效的引用
        function getEl(id) { return document.getElementById(id); }

        function showConfirm(message, onConfirm, opts) {
          var overlay = getEl('confirm-modal-overlay');
          if (!overlay) {
            // 降级到原生 confirm
            if (window.confirm(message)) { onConfirm && onConfirm(); }
            return;
          }
          var msgEl = getEl('confirm-modal-message');
          var okBtn = getEl('confirm-modal-ok');
          if (msgEl) msgEl.textContent = message;
          // 可选：自定义确认按钮文本和颜色
          if (opts && opts.okText && okBtn) okBtn.textContent = opts.okText;
          else if (okBtn) okBtn.textContent = '确定';
          // 在当前弹窗元素上暂存回调（每次打开重新读取，避免闭包引用过期元素）
          overlay.__callback = onConfirm;
          overlay.style.display = '';
        }

        function hideConfirm() {
          var overlay = getEl('confirm-modal-overlay');
          if (overlay) overlay.style.display = 'none';
        }

        var okBtn = getEl('confirm-modal-ok');
        if (okBtn) {
          okBtn.addEventListener('click', function() {
            var overlay = getEl('confirm-modal-overlay');
            var cb = overlay ? overlay.__callback : null;
            hideConfirm();
            if (cb) cb();
          });
        }
        var cancelBtn = getEl('confirm-modal-cancel');
        if (cancelBtn) {
          cancelBtn.addEventListener('click', hideConfirm);
        }
        var overlay = getEl('confirm-modal-overlay');
        if (overlay) {
          overlay.addEventListener('click', function(e) {
            if (e.target === overlay) hideConfirm();
          });
        }
        // ESC 关闭
        document.addEventListener('keydown', function(e) {
          var o = getEl('confirm-modal-overlay');
          if (e.key === 'Escape' && o && o.style.display !== 'none') {
            hideConfirm();
          }
        });

        window.__showConfirm = showConfirm;
      })();
    </script>
  </body>
</html>
