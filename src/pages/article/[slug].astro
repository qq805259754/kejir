        if (btn.disabled || likeCooldown) return;
        var currentlyLiked = btn.classList.contains('liked');
        // 乐观更新：立即切换视觉状态，提升响应感
        var nowLiked = !currentlyLiked;
        updateLikeButton(btn, nowLiked);
        if (nowLiked) { addToLikedArticles(articleId); } else { removeFromLikedArticles(articleId); }
        // 冷却期间禁用按钮，避免触发后端限流
        likeCooldown = true;
        btn.disabled = true;
        // 统一调用 toggle 接口 GET /api/article/like/{id}，后端自动切换点赞/取消
        window.__api.like(articleId).then(function(resp) {
          // 接口成功返回 data=true 表示操作成功；返回 null 可能是限流
          if (resp === null || resp === undefined) {
            // 限流或异常：回退到原状态
            updateLikeButton(btn, currentlyLiked);
            if (currentlyLiked) { addToLikedArticles(articleId); } else { removeFromLikedArticles(articleId); }
          }
        }).catch(function() {
          // 失败时回退原状态
          updateLikeButton(btn, currentlyLiked);
          if (currentlyLiked) { addToLikedArticles(articleId); } else { removeFromLikedArticles(articleId); }
        }).then(function() {
          // 冷却 2.5 秒后恢复按钮可用
          setTimeout(function() { likeCooldown = false; btn.disabled = false; }, 2500);
        });
      });
    }

    function updateLikeButton(btn, liked) {
      if (!btn) return;
      var text = btn.querySelector('.like-btn-text');
      var svg = btn.querySelector('svg path');
      if (liked) {
        btn.classList.add('liked');
        if (text) text.textContent = '已点赞';
        // 心形变实心：设置 fill
        if (svg) svg.setAttribute('fill', 'currentColor');
      } else {
        btn.classList.remove('liked');
        if (text) text.textContent = '点赞';
        // 心形变空心：清除 fill
        if (svg) svg.setAttribute('fill', 'none');
      }
    }

    function addToLikedArticles(id) {
      try {
        var arr = JSON.parse(localStorage.getItem('liked_articles') || '[]');
        id = String(id);
        if (arr.indexOf(id) < 0) { arr.push(id); localStorage.setItem('liked_articles', JSON.stringify(arr)); }
      } catch(e) {}
    }
    function removeFromLikedArticles(id) {
      try {
        var arr = JSON.parse(localStorage.getItem('liked_articles') || '[]');
        id = String(id);
        arr = arr.filter(function(x) { return x !== id; });
        localStorage.setItem('liked_articles', JSON.stringify(arr));
      } catch(e) {}
    }

    // ====== 评论区 ======
    var currentArticleId = '';

    var emojis = [
      '😀','😄','😁','😆','😅','😂','🤣','😊','😇','🙂','🙃','😉','😌','😍','🥰',
      '😘','😗','😙','😚','😋','😛','😜','🤪','😝','🤗','🤭','🤫','🤔','🤐','🤨',
      '😐','😑','😶','😏','😒','🙄','😬','🤥','😌','😔','😪','🤤','😴','😷','🤒',
      '🤕','🤢','🤮','🤧','🥵','🥶','😵','🤯','🤠','🥳','😎','🤓','🧐','😕','😟',
      '🙁','😮','😯','😲','😳','🥺','😦','😧','😨','😰','😥','😢','😭','😱','😖',
      '😣','😞','😓','😩','😫','🥱','😤','😡','😠','🤬','😈','👿','💀','💩','🤡',
      '👍','👎','👏','🙌','🙏','🤝','👌','✌️','🤞','🤟','🤘','👈','👉','👆','👇',
      '❤️','🧡','💛','💚','💙','💜','🖤','🤍','💔','❣️','💕','💞','💓','💗','💖',
      '💘','💝','🔥','⭐','🌟','✨','⚡','💯','🎉','🎊','🎁','🏆','💪','👏','🫶'
    ];

    // 当前表情插入目标（主输入框或回复框）
    var activeEmojiTarget = null;

    function initEmojiPanel() {
      var panel = document.getElementById('emoji-panel');
      if (!panel) return;
      var html = '';
      emojis.forEach(function(e) {
        html += '<button type="button" class="emoji-item" data-emoji="' + e + '">' + e + '</button>';
      });
      panel.innerHTML = html;
      panel.addEventListener('click', function(e) {
        var target = e.target.closest('.emoji-item');
        if (!target) return;
        var emoji = target.getAttribute('data-emoji');
        // 优先插入到当前激活的目标，否则插入主输入框
        var input = activeEmojiTarget || document.getElementById('comment-input');
        if (input) {
          var start = input.selectionStart;
          var end = input.selectionEnd;
          input.value = input.value.slice(0, start) + emoji + input.value.slice(end);
          input.focus();
          input.selectionStart = input.selectionEnd = start + emoji.length;
          if (input.id === 'comment-input') {
            updateCharCount();
          }
        }
      });
    }

    // 显示/隐藏共享表情面板，定位到指定锚点元素附近
    function toggleEmojiPanel(anchorEl, targetTextarea) {
      var panel = document.getElementById('emoji-panel');
      var mainEmojiBtn = document.getElementById('emoji-btn');
      if (!panel) return;
      var isVisible = panel.style.display !== 'none';
      // 如果当前已显示且点击的是同一个按钮，则关闭
      if (isVisible && activeEmojiTarget === targetTextarea) {
        panel.style.display = 'none';
        if (mainEmojiBtn) mainEmojiBtn.classList.remove('active');
        activeEmojiTarget = null;
        return;
      }
      // 设置插入目标
      activeEmojiTarget = targetTextarea;
      panel.style.display = '';
      if (mainEmojiBtn) mainEmojiBtn.classList.add('active');
      // 将面板移到锚点附近（插入到 reply-form 内或定位）
      // 使用绝对定位跟随锚点
      if (anchorEl) {
        // 尝试将面板插入到回复表单中
        var formWrapper = anchorEl.closest('.reply-form-wrapper');
        if (formWrapper && !formWrapper.querySelector('#emoji-panel')) {
          // 先从原位置移除，再插入到回复表单
          panel.parentNode && panel.parentNode.removeChild(panel);
          formWrapper.appendChild(panel);
          panel.style.position = 'relative';
          panel.style.top = 'auto';
          panel.style.left = 'auto';
        } else if (!formWrapper) {
          // 回到主评论区
          var commentForm = document.getElementById('comment-form');
          if (commentForm && panel.parentNode !== commentForm) {
            panel.parentNode && panel.parentNode.removeChild(panel);
            commentForm.appendChild(panel);
            panel.style.position = 'relative';
            panel.style.top = 'auto';
            panel.style.left = 'auto';
          }
        }
      }
    }

    function updateCharCount() {
      var input = document.getElementById('comment-input');
      var count = document.getElementById('comment-char-count');
      if (input && count) {
        count.textContent = input.value.length + '/500';
      }
    }

    function checkLogin() {
      var loggedIn = window.__api && window.__api.isLoggedIn();
      var hint = document.getElementById('comment-login-hint');
      var form = document.getElementById('comment-form');
      if (loggedIn) {
        if (hint) hint.style.display = 'none';
        if (form) form.style.display = '';
        var user = window.__api.getUser();
        if (user) {
          var nameEl = document.getElementById('comment-username');
          var avatarEl = document.getElementById('comment-user-avatar');
          if (nameEl) nameEl.textContent = user.nickname || user.username || '用户';
          if (avatarEl) {
            var av = user.avatar || user.avatarUrl || '';
            if (av) {
              avatarEl.innerHTML = '<img src="' + escHtml(av) + '" alt="头像" />';
              avatarEl.querySelector('img').onerror = function() {
                avatarEl.innerHTML = getAvatarChar(user.nickname || user.username);
              };
            } else {
              avatarEl.textContent = getAvatarChar(user.nickname || user.username);
              avatarEl.style.background = 'linear-gradient(135deg, ' + avatarColor(user.nickname || user.username) + ', ' + avatarColor(user.nickname || user.username) + 'dd)';
            }
          }
        }
      } else {
        if (hint) hint.style.display = '';
        if (form) form.style.display = 'none';
      }
    }

    function renderComment(c, currentUser, isChild) {
      var name = c.nickname || c.username || c.author || '匿名用户';
      var content = c.content || c.comment || '';
      var date = c.createTime || c.date || '';
      var avatar = c.avatar || c.avatarUrl || '';
      var cid = c.id || c.commentId;
      var uid = c.userId || c.uid;
      var replyNickname = c.replyNickname || '';
      var color = avatarColor(name);
      var childCls = isChild ? ' comment-item-child' : '';

      var html = '<div class="comment-item' + childCls + '" data-id="' + escHtml(cid) + '" data-uid="' + escHtml(uid || '') + '">';
      html += '<div class="comment-item-avatar" style="background:linear-gradient(135deg,' + color + ',' + color + 'dd);">';
      if (avatar) {
        html += '<img src="' + escHtml(avatar) + '" alt="' + escHtml(name) + '" onerror="this.style.display=\'none\';this.parentNode.textContent=\'' + getAvatarChar(name) + '\'"/>';
      } else {
        html += escHtml(getAvatarChar(name));
      }
      html += '</div>';
      html += '<div class="comment-item-body">';
      html += '<div class="comment-item-head">';
      html += '<span class="comment-item-name">' + escHtml(name) + '</span>';
      if (replyNickname) {
        html += '<span class="comment-reply-to">回复 <em>' + escHtml(replyNickname) + '</em></span>';
      }
      if (date) {
        html += '<span class="comment-item-date"><svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>' + escHtml(formatDate(date)) + '</span>';
      }
      // 回复按钮 — 右上角
      if (currentUser) {
        html += '<button type="button" class="comment-reply-btn action-btn action-btn-edit" data-reply-id="' + escHtml(cid) + '" data-reply-uid="' + escHtml(uid || '') + '" data-reply-name="' + escHtml(name) + '">';
        html += '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>';
        html += '回复';
        html += '</button>';
      }
      html += '</div>';
      html += '<div class="comment-item-content">' + escHtml(content) + '</div>';
      // 操作区：仅删除按钮
      if (currentUser && uid && (String(uid) === String(currentUser.id) || String(uid) === String(currentUser.userId))) {
        html += '<div class="comment-item-actions">';
        html += '<button type="button" class="comment-delete-btn action-btn action-btn-delete" data-del-id="' + escHtml(cid) + '">';
        html += '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>';
        html += '删除';
        html += '</button>';
        html += '</div>';
      }
      // 回复表单（默认隐藏）
      html += '<div class="reply-form-wrapper" id="reply-form-' + escHtml(cid) + '" style="display:none;">';
      html += '<div class="reply-form-hint">回复 <strong>' + escHtml(name) + '</strong></div>';
      html += '<textarea class="reply-textarea" placeholder="写下你的回复..." maxlength="500" rows="2"></textarea>';
      html += '<div class="reply-form-actions">';
      html += '<button type="button" class="reply-emoji-btn emoji-btn" data-reply-emoji="' + escHtml(cid) + '" title="插入表情">';
      html += '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>';
      html += '</button>';
      html += '<button type="button" class="action-btn reply-cancel-btn" data-cancel-id="' + escHtml(cid) + '">取消</button>';
      html += '<button type="button" class="action-btn action-btn-edit reply-submit-btn" data-submit-id="' + escHtml(cid) + '" data-reply-uid="' + escHtml(uid || '') + '">发送回复</button>';
      html += '</div>';
      html += '</div>';
      html += '</div>';
      html += '</div>';
      return html;
    }

    // 递归渲染评论及其子评论
    function renderCommentTree(c, currentUser, depth) {
      var html = renderComment(c, currentUser, depth > 0);
      // 渲染子评论（children）
      var children = c.children;
      if (children && Array.isArray(children) && children.length > 0) {
        html += '<div class="comment-children" data-depth="' + depth + '">';
        for (var i = 0; i < children.length; i++) {
          html += renderCommentTree(children[i], currentUser, depth + 1);
        }
        html += '</div>';
      }
      return html;
    }

    function loadComments(postId) {
      currentArticleId = postId;
      var list = document.getElementById('comment-list');
      var loading = document.getElementById('comment-loading');
      var empty = document.getElementById('comment-empty');
      var countEl = document.getElementById('comment-count');
      if (!list) return;

      if (loading) loading.style.display = '';
      if (empty) empty.style.display = 'none';

      window.__api.getComments(postId).then(function(data) {
        var comments = Array.isArray(data) ? data : (data && (data.records || data.list)) || [];
        if (loading) loading.style.display = 'none';
        if (countEl) countEl.textContent = comments.length;

        if (comments.length === 0) {
          list.innerHTML = '';
          if (empty) empty.style.display = '';
          return;
        }

        var currentUser = window.__api.getUser();
        var html = '';
        comments.forEach(function(c) {
          html += renderCommentTree(c, currentUser, 0);
        });
        list.innerHTML = html;

        // 绑定删除按钮
        list.querySelectorAll('.comment-delete-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            deleteComment(btn.getAttribute('data-del-id'));
          });
        });

        // 绑定回复按钮（打开/关闭回复表单）
        list.querySelectorAll('.comment-reply-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var cid = btn.getAttribute('data-reply-id');
            toggleReplyForm(cid);
          });
        });

        // 绑定回复取消按钮
        list.querySelectorAll('.reply-cancel-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var cid = btn.getAttribute('data-cancel-id');
            closeReplyForm(cid);
          });
        });

        // 绑定回复提交按钮
        list.querySelectorAll('.reply-submit-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var cid = btn.getAttribute('data-submit-id');
            var replyUid = btn.getAttribute('data-reply-uid');
            var formWrapper = document.getElementById('reply-form-' + cid);
            var textarea = formWrapper ? formWrapper.querySelector('.reply-textarea') : null;
            var content = textarea ? textarea.value.trim() : '';
            if (!content) return;
            btn.disabled = true;
            btn.textContent = '发送中...';
            submitReply(content, {
              replyUserId: replyUid,
              parentId: cid
            });
          });
        });

        // 绑定回复表情按钮
        list.querySelectorAll('.reply-emoji-btn').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            var cid = btn.getAttribute('data-reply-emoji');
            var formWrapper = document.getElementById('reply-form-' + cid);
            var textarea = formWrapper ? formWrapper.querySelector('.reply-textarea') : null;
            if (textarea) {
              toggleEmojiPanel(btn, textarea);
            }
          });
        });
      }).catch(function() {
        if (loading) loading.style.display = 'none';
        list.innerHTML = '';
        if (empty) empty.style.display = '';
      });
    }

    // 获取浏览器信息
    function getBrowserInfo() {
      try {
        var ua = navigator.userAgent;
        var match = ua.match(/(Chrome|Firefox|Safari|Edge|Opera|OPR)\/[\d.]+/);
        if (match) {
          return match[1] === 'OPR' ? 'Opera' : match[1];
        }
        return navigator.userAgent.substring(0, 50);
      } catch(e) { return ''; }
    }

    // 发表评论（顶层评论）
    function submitComment(content) {
      if (!content || !content.trim()) return;
      if (!window.__api.isLoggedIn()) return;

      var data = {
        content: content.trim(),
        articleId: String(currentArticleId),
        browser: getBrowserInfo()
      };

      var submitBtn = document.getElementById('comment-submit');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.6';
      }

      window.__api.addComment(data).then(function(res) {
        var input = document.getElementById('comment-input');
        if (input) input.value = '';
        updateCharCount();
        loadComments(currentArticleId);
      }).catch(function(err) {
        var list = document.getElementById('comment-list');
        if (list) {
          var currentUser = window.__api.getUser();
          var tempComment = {
            id: 'temp-' + Date.now(),
            userId: currentUser ? (currentUser.id || currentUser.userId) : '',
            nickname: currentUser ? (currentUser.nickname || currentUser.username) : '我',
            content: content.trim(),
            createTime: new Date().toISOString().slice(0, 10),
            avatar: currentUser ? (currentUser.avatar || '') : ''
          };
          list.insertAdjacentHTML('afterbegin', renderComment(tempComment, currentUser, false));
          var newBtn = list.querySelector('.comment-item[data-id="' + tempComment.id + '"] .comment-delete-btn');
          if (newBtn) {
            newBtn.addEventListener('click', function() {
              var item = list.querySelector('.comment-item[data-id="' + tempComment.id + '"]');
              if (item) {
                item.style.opacity = '0';
                item.style.transform = 'translateX(-20px)';
                setTimeout(function() { item.remove(); }, 300);
              }
            });
          }
        }
        var input = document.getElementById('comment-input');
        if (input) input.value = '';
        updateCharCount();
      }).finally(function() {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.style.opacity = '';
        }
      });
    }

    // 回复评论
    function submitReply(content, replyData) {
      if (!content || !content.trim()) return;
      if (!window.__api.isLoggedIn()) return;

      var data = {
        content: content.trim(),
        replyUserId: replyData.replyUserId,
        parentId: replyData.parentId,
        articleId: String(currentArticleId)
      };

      window.__api.addComment(data).then(function(res) {
        // 关闭回复表单，重新加载评论
        closeAllReplyForms();
        loadComments(currentArticleId);
      }).catch(function(err) {
        // 失败时也关闭表单并重新加载
        closeAllReplyForms();
        loadComments(currentArticleId);
      });
    }

    // 切换回复表单显示
    function toggleReplyForm(commentId) {
      var form = document.getElementById('reply-form-' + commentId);
      if (!form) return;
      var isVisible = form.style.display !== 'none';
      closeAllReplyForms();
      if (!isVisible) {
        form.style.display = '';
        var textarea = form.querySelector('.reply-textarea');
        if (textarea) setTimeout(function() { textarea.focus(); }, 50);
      }
    }

    // 关闭单个回复表单
    function closeReplyForm(commentId) {
      var form = document.getElementById('reply-form-' + commentId);
      if (form) {
        form.style.display = 'none';
        var textarea = form.querySelector('.reply-textarea');
        if (textarea) textarea.value = '';
      }
    }

    // 关闭所有回复表单
    function closeAllReplyForms() {
      document.querySelectorAll('.reply-form-wrapper').forEach(function(form) {
        form.style.display = 'none';
        var textarea = form.querySelector('.reply-textarea');
        if (textarea) textarea.value = '';
      });
      // 恢复所有提交按钮状态
      document.querySelectorAll('.reply-submit-btn').forEach(function(btn) {
        btn.disabled = false;
        btn.textContent = '发送回复';
      });
      // 隐藏表情面板并重置目标
      var emojiPanel = document.getElementById('emoji-panel');
      if (emojiPanel) emojiPanel.style.display = 'none';
      var mainEmojiBtn = document.getElementById('emoji-btn');
      if (mainEmojiBtn) mainEmojiBtn.classList.remove('active');
      activeEmojiTarget = null;
    }

    function deleteComment(commentId) {
      if (!commentId) return;
      window.__showConfirm('确定要删除这条评论吗？', function () {

      window.__api.delComment(commentId).then(function() {
        var item = document.querySelector('.comment-item[data-id="' + commentId + '"]');
        if (item) {
          item.style.opacity = '0';
          item.style.transform = 'translateX(-20px)';
          item.style.transition = 'all 0.3s';
          setTimeout(function() {
            item.remove();
            var countEl = document.getElementById('comment-count');
            var list = document.getElementById('comment-list');
            if (countEl && list) {
              var remaining = list.querySelectorAll('.comment-item').length;
              countEl.textContent = remaining;
              if (remaining === 0) {
                var empty = document.getElementById('comment-empty');
                if (empty) empty.style.display = '';
              }
            }
          }, 300);
        }
      }).catch(function() {
        var item = document.querySelector('.comment-item[data-id="' + commentId + '"]');
        if (item) {
          item.style.opacity = '0';
          item.style.transform = 'translateX(-20px)';
          item.style.transition = 'all 0.3s';
          setTimeout(function() { item.remove(); }, 300);
        }
      });
      });
    }

    // ====== 事件绑定 ======
    function initEvents() {
      var emojiBtn = document.getElementById('emoji-btn');
      var emojiPanel = document.getElementById('emoji-panel');
      if (emojiBtn && emojiPanel) {
        emojiBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var mainInput = document.getElementById('comment-input');
          toggleEmojiPanel(emojiBtn, mainInput);
        });
        document.addEventListener('click', function(e) {
          // 点击表情面板内部、主表情按钮、回复表情按钮时不关闭
          if (!e.target.closest('#emoji-panel') && !e.target.closest('.emoji-btn') && !e.target.closest('.reply-emoji-btn')) {
            emojiPanel.style.display = 'none';
            if (emojiBtn) emojiBtn.classList.remove('active');
            activeEmojiTarget = null;
          }
        });
      }

      var input = document.getElementById('comment-input');
      if (input) {
        input.addEventListener('input', updateCharCount);
        input.addEventListener('keydown', function(e) {
          if (e.ctrlKey && e.key === 'Enter') {
            e.preventDefault();
            submitComment(input.value);
          }
        });
      }

      var form = document.getElementById('comment-form');
      if (form) {
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var inputEl = document.getElementById('comment-input');
          if (inputEl) submitComment(inputEl.value);
        });
      }
    }

    // ====== 初始化 ======
    function init() {
      if (!window.__api) { setTimeout(init, 50); return; }
      checkLogin();
      initEmojiPanel();
      initEvents();
      loadArticle();
      // 监听用户状态更新（登录/退出后自动刷新评论区登录状态）
      document.addEventListener('user:updated', function() {
        checkLogin();
        if (currentArticleId) loadComments(currentArticleId);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
