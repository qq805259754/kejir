---
/**
 * PostListItem - 主内容区文章列表项（简洁行样式）
 * Props:
 *   slug, title, excerpt, date, tags?, category?, isPinned?
 * 结构：
 *   a.article-item href=/article/{slug}
 *     - 左 .article-content (meta + title + excerpt)
 *     - 右 .article-arrow (> SVG)，hover 时 translateX
 */
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  date: string | Date;
  tags?: string[];
  category?: string;
  isPinned?: boolean;
}

const { slug, title, excerpt, date, tags = [], category, isPinned } = Astro.props;

// 格式化中文日期
const d = date instanceof Date ? date : new Date(date);
const pad = (n: number) => String(n).padStart(2, '0');
const dateStr = `${d.getFullYear()}年${pad(d.getMonth() + 1)}月${pad(d.getDate())}日`;

const href = `/article/${slug}`;
---

<a href={href} class="article-item" data-reveal>
  <div class="article-content">
    <div class="article-meta">
      {category && <span class="tag tag-primary">{category}</span>}
      <span class="article-date">{dateStr}</span>
      {isPinned && (
        <span class="pinned-icon" title="置顶" aria-label="置顶">
          <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 17v5" />
            <path d="M9 10.8V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v5.8l2.5 3.2H6.5L9 10.8z" />
          </svg>
        </span>
      )}
      {tags.length > 0 && (
        <span class="article-tags-inline">
          {tags.slice(0, 2).map((t) => (
            <span class="tag">{t}</span>
          ))}
        </span>
      )}
    </div>
    <h3 class="article-title">{title}</h3>
    <p class="article-excerpt">{excerpt}</p>
  </div>
  <div class="article-arrow" aria-hidden="true">
    <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"
         stroke-linecap="round" stroke-linejoin="round">
      <path d="m9 6 6 6-6 6" />
    </svg>
  </div>
</a>

<style>
  .article-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-5) var(--sp-2);
    border-bottom: 1px solid var(--glass-border-subtle);
    transition: all var(--dur-fast) var(--ease-out);
    border-radius: var(--r-md);
    cursor: pointer;
    color: inherit;
  }
  .article-item:last-child { border-bottom: none; }
  .article-item:hover {
    background: var(--glass-bg-subtle);
    transform: translateX(4px);
    padding-left: var(--sp-4);
  }
  .article-item:hover .article-title { color: var(--brand); }
  .article-item:hover .article-arrow {
    transform: translateX(4px);
    color: var(--brand);
  }

  .article-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: 0.75rem;
    color: var(--text-tertiary);
    flex-wrap: wrap;
  }

  .article-date {
    font-variant-numeric: tabular-nums;
  }

  .pinned-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--warning);
  }
  .pinned-icon svg { width: 14px; height: 14px; }

  .article-tags-inline {
    display: inline-flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .article-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.5;
    margin: 0;
    transition: color var(--dur-fast) var(--ease-out);
    letter-spacing: -0.01em;
  }

  .article-excerpt {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-arrow {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--r-full);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--glass-bg-subtle);
    border: 1px solid var(--glass-border-subtle);
    color: var(--text-tertiary);
    transition: all var(--dur-fast) var(--ease-spring);
  }
  .article-arrow svg {
    width: 18px;
    height: 18px;
  }

  /* 全局 .article-item 样式在 global.css 中定义了一些默认，这里覆盖为行布局 */
  @media (max-width: 768px) {
    .article-item { padding: var(--sp-4) var(--sp-2); }
    .article-arrow { width: 32px; height: 32px; }
    .article-arrow svg { width: 16px; height: 16px; }
  }
</style>
