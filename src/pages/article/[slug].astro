<script is:inline data-astro-rerun>
  (function() {
    'use strict';

    // ====== 工具函数 ======
    function escHtml(s) {
      if (s == null) return '';
      return String(s).replace(/[&<>"']/g, function(c) {
        return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
      });
    }

    // 安全 URL 校验：仅允许 http/https/mailto/相对路径，禁止 javascript:/data: 等危险协议
    function safeUrl(url) {
      if (!url) return '';
      var u = String(url).trim();
      // 去除所有空白（防止 java\tscript: 绕过）
      u = u.replace(/[\s\x00-\x20]+/g, '');
      // 相对路径、锚点、协议白名单
      if (/^(\/|\.\/|\.\.\/|#|mailto:|tel:)/i.test(u)) return u;
      if (/^(https?:)/i.test(u)) return u;
      // 其余（javascript:、data:、vbscript: 等）一律拒绝
      return '';
    }

    // HTML 净化：移除 <script>/<iframe>/<object> 等危险标签，剥离事件属性与 javascript: 链接
    function sanitizeHtml(html) {
      if (!html) return '';
      var s = String(html);
      // 移除危险整块标签及其内容
      s = s.replace(/<\s*(script|iframe|object|embed|applet|form|style|meta|link|base)\b[\s\S]*?<\/\s*\1\s*>/gi, '');
      // 移除自闭合危险标签
      s = s.replace(/<\s*(script|iframe|object|embed|applet|style|meta|link|base)\b[^>]*\/?>/gi, '');
      // 移除所有 on* 事件属性（onerror, onload, onclick 等）
      s = s.replace(/\son\w+\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, '');
      // 净化 href/src 属性中的危险协议（javascript:、data:、vbscript:）
      s = s.replace(/(href|src)\s*=\s*("[^"]*"|'[^']*'|[^\s>]+)/gi, function(match, attr, val) {
        var quote = '';
        var raw = val;
        if ((raw.charAt(0) === '"' && raw.charAt(raw.length - 1) === '"') ||
            (raw.charAt(0) === "'" && raw.charAt(raw.length - 1) === "'")) {
          quote = raw.charAt(0);
          raw = raw.slice(1, -1);
        }
        var safe = safeUrl(raw);
        if (!safe) return ''; // 危险链接直接移除整个属性
        return attr + '=' + quote + safe + quote;
      });
      return s;
    }

    function formatDate(d) {
      if (!d) return '';
      var s = String(d).trim();
      var parts = s.split(' ');
      var datePart = parts[0].replace(/T.*$/, '').slice(0, 10);
      var timePart = parts[1] ? parts[1].slice(0, 5) : '';
      var dp = datePart.split('-');
      if (dp.length === 3) {
        return dp[0] + '-' + dp[1] + '-' + dp[2] + (timePart ? ' ' + timePart : '');
      }
      return datePart;
    }

    function getAvatarChar(name) {
      return name ? name.charAt(0).toUpperCase() : 'U';
    }

    function avatarColor(name) {
      var colors = ['#667eea','#f093fb','#43e97b','#fa709a','#4facfe','#f5576c','#a18cd1','#fbc2eb','#00d2d3','#9c64ff'];
      var h = 0;
      for (var i = 0; name && i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
      return colors[Math.abs(h) % colors.length];
    }

    // ====== Markdown 解析（增强版）======
    function parseMarkdown(md) {
      if (!md) return '';
      var html = String(md);
      html = html.replace(/```(\w*)\n?([\s\S]*?)```/g, function(_, lang, code) {
        return '<pre><code>' + escHtml(code.trim()) + '</code></pre>';
      });
      var blocks = html.split(/\n{2,}/);
      var out = '';
      blocks.forEach(function(b) {
        b = b.trim();
        if (!b) return;
        if (b.startsWith('<pre>') || b.startsWith('<table') || b.startsWith('<h')) { out += b; return; }
        if (/^####\s+/.test(b)) out += '<h3>' + inline(b.replace(/^####\s+/, '')) + '</h3>';
        else if (/^###\s+/.test(b)) out += '<h3>' + inline(b.replace(/^###\s+/, '')) + '</h3>';
        else if (/^##\s+/.test(b)) out += '<h2>' + inline(b.replace(/^##\s+/, '')) + '</h2>';
        else if (/^#\s+/.test(b)) out += '<h2>' + inline(b.replace(/^#\s+/, '')) + '</h2>';
        else if (/^>\s?/.test(b)) out += '<blockquote>' + inline(b.replace(/^>\s?/gm, '')) + '</blockquote>';
        else if (/^\|.*\|$/.test(b) && b.split('\n').length >= 2) out += parseTable(b);
        else if (/^[-*]\s+/m.test(b)) out += parseList(b, 'ul');
        else if (/^\d+\.\s+/m.test(b)) out += parseList(b, 'ol');
        else {
          var lines = b.split('\n').map(inline).join('<br>');
          out += '<p>' + lines + '</p>';
