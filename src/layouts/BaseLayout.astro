            var(--lg-highlight, rgba(255,255,255,0.35)) 50%,
            hsl(calc(var(--brand-hue, 234) + 50) 90% 85% / 0.15) 80%,
            transparent) top left / 100% 1px no-repeat,
          linear-gradient(105deg, transparent 30%,
            rgba(255,255,255,0.04) 43%,
            var(--lg-sweep-color, rgba(255,255,255,0.20)) 50%,
            rgba(255,255,255,0.04) 57%,
            transparent 70%),
          linear-gradient(135deg,
            hsl(var(--brand-hue) 80% 70% / 0.05) 0%,
            transparent 50%,
            hsl(calc(var(--brand-hue) + 60) 80% 70% / 0.03) 100%);
        background-size: 100% 1px, 250% 100%, 100% 100%;
        background-position: 0 0, -150% 0, 0 0;
