            var u = safeUrl(url);
            return u ? '<a href="' + u + '" target="_blank" rel="noopener">' + text + '</a>' : text;
          });
      }
      function parseTable(text) {
        var rows = text.trim().split('\n');
        if (rows.length < 2) return '<p>' + inline(text) + '</p>';
        var html = '<table>';
        rows.forEach(function(row, i) {
          if (i === 1 && /^\|[\s:|-]+\|$/.test(row)) return;
          var cells = row.split('|').filter(function(c, j, arr) {
            return j > 0 && j < arr.length - 1;
          }).map(function(c) { return c.trim(); });
          html += '<tr>';
          if (i === 0) cells.forEach(function(c) { html += '<th>' + inline(c) + '</th>'; });
          else cells.forEach(function(c) { html += '<td>' + inline(c) + '</td>'; });
          html += '</tr>';
        });
        html += '</table>';
        return html;
      }
      function parseList(text, tag) {
        var items = text.split('\n').filter(function(l) { return /^[-*]\s+/.test(l) || /^\d+\.\s+/.test(l); });
        var html = '<' + tag + '>';
        items.forEach(function(l) {
          html += '<li>' + inline(l.replace(/^[-*]\s+/, '').replace(/^\d+\.\s+/, '')) + '</li>';
        });
        html += '</' + tag + '>';
        return html;
      }
    }

    // ====== 判断内容是 HTML 还是 Markdown ======
    function renderContent(content) {
      if (!content) return '';
      var trimmed = content.trim();
      // 检测是否包含 HTML 块级或行级标签，若有则直接作为 HTML 渲染
      var hasHtmlTags = /<(p|div|h[1-6]|ul|ol|li|table|tr|td|th|pre|blockquote|br|img|a|span|strong|em|code|section|article|hr|figure|figcaption)\b/i.test(trimmed);
      if (hasHtmlTags) return trimmed;
      return parseMarkdown(trimmed);
    }

    // ====== 文章加载 ======
    function extractId() {
      var path = location.pathname;
      var m = path.match(/\/article\/([^/]+)\/?$/);
      return m ? decodeURIComponent(m[1]) : '';
    }

    function applyArticle(article) {
      if (!article) return;
      var titleEl = document.getElementById('article-title');
      var metaEl = document.getElementById('article-meta');
      var contentEl = document.getElementById('article-content');
      var tagsEl = document.getElementById('article-tags');

      if (titleEl && article.title) {
        titleEl.textContent = article.title;
        document.title = article.title + ' - 科技热';
      }

      if (metaEl) {
        var cat = article.category || article.categoryName || '';
        if (cat && typeof cat === 'object') cat = cat.name || '';
        var date = article.createTime || article.publishTime || article.date || '';
        var metaHtml = '';
        if (cat) metaHtml += '<span class="tag tag-primary">' + escHtml(cat) + '</span>';
        if (date) {
          metaHtml += '<span class="article-detail-date"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>' + escHtml(formatDate(date)) + '</span>';
        }
        metaEl.innerHTML = metaHtml;
      }

      // 重建点赞按钮（文章下方居中位置）
